    def _apply_filters(self, df: pd.DataFrame, filters: Dict[str, Any]) -> pd.DataFrame:
        """Apply filters to dataframe"""
        filtered = df.copy()
        
        # Handle compound filters if present
        if 'compound' in filters:
            return self._apply_compound_filters(filtered, filters['compound'])
        
        # Handle simple filters
        for col, filter_info in filters.items():
            if col not in filtered.columns:
                continue
            
            filter_type = filter_info['type']
            value = filter_info['value']
            
            try:
                if filter_type == 'equals':
                    filtered = filtered[filtered[col] == value]
                elif filter_type == 'contains':
                    filtered = filtered[filtered[col].astype(str).str.contains(
                        value, case=False, na=False
                    )]
                elif filter_type == 'greater':
                    filtered = filtered[filtered[col] > float(value)]
                elif filter_type == 'less':
                    filtered = filtered[filtered[col] < float(value)]
            except Exception as e:
                logger.warning(f"Error applying filter on {col}: {e}")
        
        return filtered
    
    def _apply_compound_filters(self, df: pd.DataFrame, compound) -> pd.DataFrame:
        """Apply compound query conditions"""
        
        if not compound.conditions:
            return df
        
        mask = pd.Series([True] * len(df))
        
        for i, condition in enumerate(compound.conditions):
            try:
                col = condition.column
                op = condition.operator
                val = condition.value
                
                if col not in df.columns:
                    continue
                
                if op == '=':
                    cond_mask = df[col] == val
                elif op == '!=':
                    cond_mask = df[col] != val
                elif op == '>':
                    cond_mask = df[col] > val
                elif op == '<':
                    cond_mask = df[col] < val
                elif op == 'contains':
                    cond_mask = df[col].astype(str).str.contains(val, case=False, na=False)
                else:
                    continue
                
                if i == 0:
                    mask = cond_mask
                elif i <= len(compound.logical_operators):
                    logic_op = compound.logical_operators[i-1]
                    if logic_op == 'AND':
                        mask = mask & cond_mask
                    elif logic_op == 'OR':
                        mask = mask | cond_mask
                    elif logic_op == 'NOT':
                        mask = mask & ~cond_mask
                        
            except Exception as e:
                logger.warning(f"Error applying condition {condition}: {e}")
        
        return df[mask]
    
    def _search_mask(self, df: pd.DataFrame, term: str) -> pd.Series:
        """Create search mask for term"""
        mask = pd.Series([False] * len(df))
        
        for col in df.select_dtypes(include=['object']).columns:
            try:
                col_mask = df[col].astype(str).str.contains(
                    term, case=False, na=False
                )
                mask |= col_mask
            except:
                pass
        
        return mask
    
    def _find_similar_ids(self, target_id: str, df: pd.DataFrame) -> List[str]:
        """Find similar IDs"""
        similar = []
        
        id_cols = [col for col in df.columns 
                  if any(term in col.lower() for term in ['id', 'code', 'number'])]
        
        if not id_cols:
            id_cols = df.select_dtypes(include=['object']).columns[:3]
        
        for col in id_cols:
            try:
                unique_values = df[col].dropna().astype(str).unique()[:100]
                
                for value in unique_values:
                    if (target_id.lower() in value.lower() or 
                        value.lower() in target_id.lower() or
                        self._string_similarity(target_id, value) > 0.6):
                        similar.append(value)
                        
                        if len(similar) >= 5:
                            return similar
            except:
                pass
        
        return similar[:5]
    
    def _string_similarity(self, s1: str, s2: str) -> float:
        """Calculate string similarity"""
        s1, s2 = s1.lower(), s2.lower()
        
        len_sim = 1 - abs(len(s1) - len(s2)) / max(len(s1), len(s2))
        
        set1, set2 = set(s1), set(s2)
        char_sim = len(set1 & set2) / len(set1 | set2) if set1 | set2 else 0
        
        return (len_sim + char_sim) / 2
    
    def _format_dataframe(self, df: pd.DataFrame) -> Dict[str, Any]:
        """Format dataframe for display"""
        if df.empty:
            return {'columns': [], 'data': []}
        
        df = df.replace([np.inf, -np.inf], np.nan)
        
        columns = df.columns.tolist()
        data = []
        
        for _, row in df.iterrows():
            row_data = []
            for col in columns:
                value = row[col]
                
                if pd.isna(value):
                    row_data.append(None)
                elif isinstance(value, (float, np.floating)):
                    row_data.append(round(float(value), 2))
                elif isinstance(value, (int, np.integer)):
                    row_data.append(int(value))
                else:
                    str_value = str(value)
                    if len(str_value) > 150:
                        str_value = str_value[:150] + "..."
                    row_data.append(str_value)
            
            data.append(row_data)
        
        return {'columns': columns, 'data': data}
    
    def _error_response(self, message: str) -> Dict[str, Any]:
        """Generate error response"""
        return {
            'analysis': f"❌ {message}",
            'has_data': False,
            'columns': [],
            'data': [],
            'row_count': 0,
            'query_type': 'error',
            'confidence': 0.0
        }


class HybridQueryProcessor:
    """Hybrid processor with safe serialization"""
    
    def __init__(self):
        self.pattern_processor = SimpleQueryProcessor()
        self.ai_service = NVIDIANIMService()
        self.complexity_analyzer = QueryComplexityAnalyzer()
    
    async def process_query(self, query: str, df: pd.DataFrame) -> Dict[str, Any]:
        """Process query with safe serialization"""
        
        # Clean DataFrame
        df = validate_and_clean_data(df)
        
        start_time = time.time()
        
        # Pattern matching
        initial_result = self.pattern_processor.process_query(query, df)
        pattern_time = time.time() - start_time
        
        # Check if AI needed
        needs_ai, reason = self.complexity_analyzer.needs_ai(query, initial_result)
        
        # AI enhancement if needed
        if needs_ai and self.ai_service.enabled:
            ai_start = time.time()
            enhanced = await self.ai_service.analyze_data(query, df, initial_result)
            ai_time = time.time() - ai_start
            
            # Merge results
            final = self._merge_results(initial_result, enhanced)
            final['processing_times'] = {
                'pattern': round(pattern_time, 3),
                'ai': round(ai_time, 3),
                'total': round(time.time() - start_time, 3)
            }
            
            return final
        else:
            initial_result['processing_times'] = {
                'pattern': round(pattern_time, 3),
                'total': round(pattern_time, 3)
            }
            initial_result['analysis_type'] = 'pattern_based'
            
            return initial_result
    
    def _merge_results(self, pattern_result: Dict, ai_result: Dict) -> Dict:
        """Merge results safely"""
        
        merged = pattern_result.copy()
        
        if ai_result.get('has_ai_insights'):
            original = pattern_result.get('analysis', '')
            ai_analysis = ai_result.get('ai_analysis', '')
            
            merged['analysis'] = f"{original}\n\n**AI Analysis:**\n{ai_analysis}"
            merged['key_insights'] = ai_result.get('key_insights', [])
            merged['has_ai_insights'] = True
            merged['analysis_type'] = 'nvidia_nim_enhanced'
        
        return merged


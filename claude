class IntelligentQueryProcessor:
    """Main query processor with intelligent understanding"""
    
    def __init__(self):
        self.executor = SmartQueryExecutor()
    
    async def process_query(self, query: str, df: pd.DataFrame, 
                           data_context: Dict[str, Any]) -> Dict[str, Any]:
        """Process query with full pipeline"""
        
        try:
            result = await self.executor.execute(query, df, data_context)
            
            result['suggestions'] = self._generate_suggestions(result, query)
            result['query_executed'] = True
            result['timestamp'] = datetime.now().isoformat()
            
            return result
            
        except Exception as e:
            logger.error(f"Error processing query: {e}\n{traceback.format_exc()}")
            
            return {
                'analysis': f"❌ **Error processing query**\n\n{str(e)}",
                'has_data': False,
                'columns': [],
                'data': [],
                'row_count': 0,
                'query_executed': False,
                'error': str(e)
            }
    
    def _generate_suggestions(self, result: Dict[str, Any], query: str) -> List[str]:
        """Generate follow-up suggestions"""
        
        suggestions = []

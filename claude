class SimpleQueryProcessor:
    """Pattern-based query processor with proper serialization"""
    
    def __init__(self):
        self.query_patterns = self._build_query_patterns()
    
    def _build_query_patterns(self):
        return [
            (r'\b(show|display|list|get)\s+(all|everything|data|records?)\b', 'show_all'),
            (r'\b(show|display|list|get)\s+(?:me\s+)?(?:the\s+)?(?:first\s+|top\s+)?(\d+)\s*(?:rows?|records?)\b', 'show_top'),
            (r'\b(how\s+many|count|total|number)\s+.*?([\w\s]+)', 'count_filtered'),
            (r'\b(how\s+many|count|total|number\s+of)\s+(?:records?|rows?)\b', 'count_all'),
            (r'\b(?:sih|SIH)\s*["\']?(\d+)["\']?', 'find_by_id'),
            (r'\b(?:search|find|look\s+for)\s+(?:for\s+)?["\']?([^"\']+)["\']?', 'search'),
        ]
    
    def process_query(self, query: str, df: pd.DataFrame) -> Dict[str, Any]:
        """Process query with safe serialization"""
        
        # Clean the DataFrame first
        df = validate_and_clean_data(df)
        
        query_lower = query.lower().strip()
        
        # Match patterns
        intent = None
        params = {}
        
        for pattern, intent_type in self.query_patterns:
            match = re.search(pattern, query_lower, re.IGNORECASE)
            if match:
                intent = intent_type
                if intent_type == 'show_top':
                    groups = match.groups()
                    for g in groups:
                        if g and g.isdigit():
                            params['n'] = int(g)
                            break
                elif intent_type == 'count_filtered':
                    params['filter_term'] = match.group(2) if len(match.groups()) > 1 else None
                elif intent_type in ['search', 'find_by_id']:
                    params['search_term'] = match.group(1)
                break
        
        if not intent:
            intent = 'show_all'
        
        # Execute based on intent
        try:
            if intent == 'show_all':
                return self._show_all(df, query)
            elif intent == 'show_top':
                return self._show_top(df, params.get('n', 10), query)
            elif intent == 'count_all':
                return self._count_all(df, query)
            elif intent == 'count_filtered':
                return self._count_filtered(df, params.get('filter_term'), query)
            elif intent == 'find_by_id':
                return self._find_by_id(df, params.get('search_term'), query)
            elif intent == 'search':
                return self._search(df, params.get('search_term'), query)
            else:
                return self._show_all(df, query)
        except Exception as e:
            logger.error(f"Query processing error: {e}")
            return self._error_response(str(e))
    
    def _show_all(self, df: pd.DataFrame, query: str) -> Dict[str, Any]:
        """Show all with safe serialization"""
        display_df = df.head(MAX_DISPLAY_ROWS)
        
        # Sanitize the data
        sanitized = sanitize_dataframe_for_json(display_df)
        
        return {
            'analysis': f"Showing {len(display_df)} of {len(df)} total records.",
            'has_data': True,
            'columns': sanitized['columns'],
            'data': sanitized['data'],
            'row_count': len(display_df),
            'query_executed': True,
            'query_type': 'show_all'
        }
    
    def _show_top(self, df: pd.DataFrame, n: int, query: str) -> Dict[str, Any]:
        """Show top N with safe serialization"""
        n = min(n, MAX_DISPLAY_ROWS)
        display_df = df.head(n)
        
        sanitized = sanitize_dataframe_for_json(display_df)
        
        return {
            'analysis': f"Showing top {n} records from {len(df)} total.",
            'has_data': True,
            'columns': sanitized['columns'],
            'data': sanitized['data'],
            'row_count': len(display_df),
            'query_executed': True,
            'query_type': 'show_top'
        }
    
    def _count_all(self, df: pd.DataFrame, query: str) -> Dict[str, Any]:
        """Count all records"""
        count = len(df)
        
        summary_df = pd.DataFrame({
            'Metric': ['Total Records'],
            'Value': [count]
        })
        
        sanitized = sanitize_dataframe_for_json(summary_df)
        
        return {
            'analysis': f"Your dataset contains {count:,} total records.",
            'has_data': True,
            'columns': sanitized['columns'],
            'data': sanitized['data'],
            'row_count': 1,
            'query_executed': True,
            'query_type': 'count_all'
        }
    
    def _count_filtered(self, df: pd.DataFrame, filter_term: str, query: str) -> Dict[str, Any]:
        """Count filtered with safe serialization"""
        if not filter_term:
            return self._count_all(df, query)
        
        # Clean filter term
        filter_term = filter_term.strip()
        
        # Extract meaningful search term
        if 'hardware' in filter_term.lower():
            search_term = 'Hardware'
        elif 'software' in filter_term.lower():
            search_term = 'Software'
        else:
            words = filter_term.split()
            ignore = {'are', 'there', 'in', 'this', 'file', 'the'}
            meaningful = [w for w in words if w.lower() not in ignore]
            search_term = meaningful[0] if meaningful else filter_term
        
        # Search
        mask = pd.Series([False] * len(df))
        found_columns = []
        
        for col in df.columns:
            if df[col].dtype == 'object':
                try:
                    col_mask = df[col].astype(str).str.contains(search_term, case=False, na=False)
                    if col_mask.any():
                        found_columns.append(col)
                    mask |= col_mask
                except:
                    pass
        
        count = int(mask.sum())
        
        summary_df = pd.DataFrame({
            'Search Term': [search_term],
            'Matching Records': [count],
            'Total Records': [len(df)],
            'Percentage': [f"{(count/len(df)*100):.1f}%"]
        })
        
        sanitized = sanitize_dataframe_for_json(summary_df)
        
        analysis = f"Found {count:,} records containing '{search_term}'. "
        analysis += f"This is {(count/len(df)*100):.1f}% of all records."
        
        return {
            'analysis': analysis,
            'has_data': True,
            'columns': sanitized['columns'],
            'data': sanitized['data'],
            'row_count': 1,
            'query_executed': True,
            'query_type': 'count_filtered'
        }
    
    def _find_by_id(self, df: pd.DataFrame, id_value: str, query: str) -> Dict[str, Any]:
        """Find by ID with safe serialization"""
        if not id_value:
            return self._error_response("No ID provided")
        
        id_value = f"SIH{id_value}"
        
        mask = pd.Series([False] * len(df))
        
        for col in df.columns:
            if df[col].dtype == 'object':
                try:
                    col_mask = df[col].astype(str).str.contains(id_value, case=False, na=False)
                    mask |= col_mask
                except:
                    pass
        
        result_df = df[mask]
        
        if len(result_df) > 0:
            sanitized = sanitize_dataframe_for_json(result_df)
            analysis = f"Found record with ID '{id_value}'."
        else:
            sanitized = {'columns': [], 'data': []}
            analysis = f"No record found with ID '{id_value}'."
        
        return {
            'analysis': analysis,
            'has_data': len(result_df) > 0,
            'columns': sanitized['columns'],
            'data': sanitized['data'],
            'row_count': len(result_df),
            'query_executed': True,
            'query_type': 'find_by_id'
        }
    
    def _search(self, df: pd.DataFrame, search_term: str, query: str) -> Dict[str, Any]:
        """Search with safe serialization"""
        if not search_term:
            return self._error_response("No search term")
        
        mask = pd.Series([False] * len(df))
        
        for col in df.columns:
            if df[col].dtype == 'object':
                try:
                    col_mask = df[col].astype(str).str.contains(search_term, case=False, na=False)
                    mask |= col_mask
                except:
                    pass
        
        result_df = df[mask].head(MAX_DISPLAY_ROWS)
        total = int(mask.sum())
        

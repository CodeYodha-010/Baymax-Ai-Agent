        }
    
    def _handle_compare(self, context: QueryContext, df: pd.DataFrame) -> Dict[str, Any]:
        """Handle comparison queries"""
        
        items = []
        for token in context.tokens:
            if len(token) > 3 and token not in ['compare', 'versus', 'difference', 'between']:
                items.append(token)
        
        if len(items) < 2:
            return self._error_response("Please specify at least two items to compare.")
        
        item1, item2 = items[0], items[1]
        
        mask1 = self._search_mask(df, item1)
        mask2 = self._search_mask(df, item2)
        
        df1 = df[mask1]
        df2 = df[mask2]
        
        response = f"⚖️ **Comparing '{item1}' vs '{item2}'**\n\n"
        
        response += f"• **{item1}**: {len(df1):,} records\n"
        response += f"• **{item2}**: {len(df2):,} records\n\n"
        
        numeric_cols = df.select_dtypes(include=[np.number]).columns
        
        if len(numeric_cols) > 0 and len(df1) > 0 and len(df2) > 0:
            response += "**Numeric Comparisons:**\n"
            
            comparison_data = []
            
            for col in numeric_cols[:3]:
                comp = {
                    'Metric': col,
                    f'{item1} Avg': round(df1[col].mean(), 2),
                    f'{item2} Avg': round(df2[col].mean(), 2),
                    'Difference': round(df1[col].mean() - df2[col].mean(), 2)
                }
                comparison_data.append(comp)
                
                response += f"\n*{col}:*\n"
                response += f"• {item1}: {comp[f'{item1} Avg']:,.2f}\n"
                response += f"• {item2}: {comp[f'{item2} Avg']:,.2f}\n"
                
                diff = comp['Difference']
                if abs(diff) > 0.01:
                    winner = item1 if diff > 0 else item2
                    response += f"• {winner} is higher by {abs(diff):,.2f}\n"
            
            comp_df = pd.DataFrame(comparison_data)
            display_data = self._format_dataframe(comp_df)
        else:
            display_data = {'columns': [], 'data': []}
        
        return {
            'analysis': response,
            'has_data': len(comparison_data) > 0 if 'comparison_data' in locals() else False,
            'columns': display_data['columns'],
            'data': display_data['data'],
            'row_count': len(display_data['data']),
            'query_type': 'compare',
            'confidence': context.confidence
        }
    
    def _handle_sort(self, context: QueryContext, df: pd.DataFrame) -> Dict[str, Any]:

class NVIDIA_NIM_Client:
    """Bulletproof client for NVIDIA NIM with JSON self-correction and fallbacks."""

    def __init__(self, api_key: str, model: str, endpoint: str):
        self.api_key = api_key
        self.model = model
        self.endpoint = endpoint
        self.headers = {
            "Authorization": f"Bearer {self.api_key}",
            "Content-Type": "application/json"
        }
        self.max_retries = 2

    def _extract_json_from_text(self, text: str) -> Optional[Dict]:
        """Extract the first valid JSON object from messy LLM output using brace matching."""
        if not text:
            return None

        brace_stack = []
        start = -1
        for i, char in enumerate(text):
            if char == '{':
                if not brace_stack:
                    start = i
                brace_stack.append(char)
            elif char == '}':
                if brace_stack:
                    brace_stack.pop()
                    if not brace_stack and start != -1:
                        candidate = text[start:i + 1]
                        try:
                            parsed = json.loads(candidate)
                            if isinstance(parsed, dict):
                                return parsed
                        except (json.JSONDecodeError, TypeError):
                            continue
        return None

    def _correct_json_with_llm(self, malformed_text: str, original_system_prompt: str) -> Optional[Dict]:
        """Ask the LLM to fix its own malformed JSON."""
        if len(malformed_text) > 3000:
            malformed_text = malformed_text[:3000] + "... [truncated]"

        correction_instruction = """
You generated malformed or incomplete JSON. Re-output your response as a SINGLE, VALID JSON OBJECT.

Rules:
1. Output ONLY a JSON object. No markdown, no text before or after.
2. Must include these keys: "intent", "parameters", "thought_process", "query_plan"
3. "query_plan" must be a list of objects, each with "operation", "parameters", "description"

Example:
{
  "intent": "detailed_analysis",
  "parameters": {},
  "thought_process": "I analyzed the query.",
  "query_plan": []
}
        """

        payload = {
            "model": self.model,
            "messages": [
                {"role": "system", "content": correction_instruction},
                {"role": "user", "content": f"Fix this malformed output:\n\n{malformed_text}"}
            ],
            "temperature": 0.1,
            "max_tokens": 1000
        }

        try:
            response = requests.post(self.endpoint, headers=self.headers, json=payload, timeout=30)
            response.raise_for_status()
            result = response.json()

            if 'choices' not in result or not result['choices']:
                return None

            content = result['choices'][0]['message']['content'].strip()
            return self._extract_json_from_text(content)

        except Exception as e:
            print(f"[JSON Correction Failed]: {str(e)}")
            return None

    def _validate_and_fill(self, data: Dict) -> Dict:
        """Ensure minimum structure. Fill missing keys."""
        required_keys = ['intent', 'parameters', 'thought_process', 'query_plan']
        for key in required_keys:
            if key not in data:
                data[key] = [] if key == 'query_plan' else {}
        if not isinstance(data['query_plan'], list):
            data['query_plan'] = []
        if not isinstance(data['parameters'], dict):
            data['parameters'] = {}
        return data

    def generate_structured_response(self, system_prompt: str, user_query: str) -> Dict[str, Any]:
        payload = {
            "model": self.model,
            "messages": [
                {"role": "system", "content": system_prompt},
                {"role": "user", "content": user_query}
            ],
            "temperature": 0.3,
            "max_tokens": 800,
            "response_format": {"type": "json_object"}
        }

        for attempt in range(self.max_retries + 1):
            try:
                response = requests.post(self.endpoint, headers=self.headers, json=payload, timeout=30)
                response.raise_for_status()
                result = response.json()

                if 'choices' not in result or len(result['choices']) == 0:
                    raise ValueError("No 'choices' in LLM response")

                llm_content = result['choices'][0]['message']['content'].strip()
                print(f"[Raw LLM Response]: {llm_content[:500]}...")

                # === LAYER 1: Direct JSON Parse ===
                try:
                    structured_data = json.loads(llm_content)
                    if isinstance(structured_data, dict):
                        return self._validate_and_fill(structured_data)
                except json.JSONDecodeError:
                    pass

                # === LAYER 2: Extract First JSON Object ===
                extracted = self._extract_json_from_text(llm_content)
                if extracted is not None:
                    return self._validate_and_fill(extracted)

                # === LAYER 3: Self-Correction (if retry available) ===
                if attempt < self.max_retries:
                    print(f"[Attempt {attempt + 1}] JSON malformed. Requesting self-correction...")
                    corrected = self._correct_json_with_llm(llm_content, system_prompt)
                    if corrected is not None:
                        return self._validate_and_fill(corrected)

            except Exception as e:
                print(f"[Attempt {attempt + 1} Failed]: {str(e)}")
                if attempt == self.max_retries:
                    break
                time.sleep(1)  # Brief pause before retry

        # === LAYER 4: SAFE FALLBACK ===
        print("[FALLBACK] Using default structured response due to repeated JSON failures.")
        return {
            'intent': 'general',
            'parameters': {},
            'thought_process': 'Fallback due to repeated JSON parsing errors. Please rephrase your question.',
            'query_plan': []
        }


class OperationBuilder:
    """Dynamically builds and executes pandas operations based on structured plan."""

    def __init__(self, df: pd.DataFrame):
        self.df = df.copy()
        self.steps = []
        self.intermediates = {}
        self.execution_log = []

    def add_filter_step(self, column: str, operator: str, value: Any, step_id: str = None):
        op_map = {
            '=': lambda col, val: self.df[col] == val,
            '!=': lambda col, val: self.df[col] != val,
            '>': lambda col, val: self.df[col] > val,
            '<': lambda col, val: self.df[col] < val,
            '>=': lambda col, val: self.df[col] >= val,
            '<=': lambda col, val: self.df[col] <= val,
            'contains': lambda col, val: self.df[col].astype(str).str.contains(str(val), case=False, na=False),
            'in': lambda col, val: self.df[col].isin(val) if isinstance(val, (list, tuple, set)) else self.df[col] == val,
        }
        if operator not in op_map:
            raise ValueError(f"Unsupported operator: {operator}")

        step = {
            'type': 'filter',
            'column': column,
            'operator': operator,
            'value': value,
            'func': op_map[operator],
            'id': step_id or f"filter_{len(self.steps)}"
        }
        self.steps.append(step)

    def add_aggregate_step(self, column: str, function: str, group_by: str = None, step_id: str = None):
        supported_funcs = ['sum', 'mean', 'count', 'max', 'min', 'std', 'median']
        if function not in supported_funcs:
            raise ValueError(f"Unsupported aggregation: {function}")

        step = {
            'type': 'aggregate',
            'column': column,
            'function': function,
            'group_by': group_by,
            'id': step_id or f"agg_{len(self.steps)}"
        }
        self.steps.append(step)

    def add_sort_step(self, column: str, ascending: bool = True, step_id: str = None):
        step = {
            'type': 'sort',
            'column': column,
            'ascending': ascending,
            'id': step_id or f"sort_{len(self.steps)}"
        }
        self.steps.append(step)

    def add_limit_step(self, n: int, step_id: str = None):
        step = {
            'type': 'limit',
            'n': n,
            'id': step_id or f"limit_{len(self.steps)}"
        }
        self.steps.append(step)

    def execute(self) -> Tuple[pd.DataFrame, List[Dict]]:
        current_df = self.df.copy()
        execution_log = []

        for step in self.steps:
            step_start = datetime.now()
            try:
                if step['type'] == 'filter':
                    mask = step['func'](step['column'], step['value'])
                    prev_len = len(current_df)
                    current_df = current_df[mask]
                    msg = f"Filtered {step['column']} {step['operator']} {step['value']}: {prev_len} → {len(current_df)} rows"
                    execution_log.append({'step': step['id'], 'message': msg, 'success': True})

                elif step['type'] == 'aggregate':
                    if step['group_by']:
                        grouped = current_df.groupby(step['group_by'])[step['column']].agg(step['function']).reset_index()
                        current_df = grouped.rename(columns={step['column']: f"{step['function']}_{step['column']}"})
                    else:
                        result = current_df[step['column']].agg(step['function'])
                        current_df = pd.DataFrame([{f"{step['function']}_{step['column']}": result}])
                    msg = f"Aggregated {step['function']} on {step['column']}"
                    execution_log.append({'step': step['id'], 'message': msg, 'success': True})

                elif step['type'] == 'sort':
                    current_df = current_df.sort_values(by=step['column'], ascending=step['ascending']).reset_index(drop=True)
                    msg = f"Sorted by {step['column']} {'ascending' if step['ascending'] else 'descending'}"
                    execution_log.append({'step': step['id'], 'message': msg, 'success': True})

                elif step['type'] == 'limit':
                    current_df = current_df.head(step['n'])
                    msg = f"Limited to top {step['n']} rows"
                    execution_log.append({'step': step['id'], 'message': msg, 'success': True})

                self.intermediates[step['id']] = current_df.copy()

            except Exception as e:
                msg = f"Step {step['id']} failed: {str(e)}"
                execution_log.append({'step': step['id'], 'message': msg, 'success': False, 'error': str(e)})

            step_end = datetime.now()
            execution_log[-1]['duration_ms'] = int((step_end - step_start).total_seconds() * 1000)

        return current_df, execution_log


class TableAgent:
    """Advanced, bulletproof Table Agent with robust LLM interaction."""

    def __init__(self, df: pd.DataFrame):
        self.df = df
        self.column_types = self._analyze_column_types()
        self.numeric_columns = [col for col, dtype in self.column_types.items() if dtype in ['int64', 'float64']]
        self.date_columns = [col for col, dtype in self.column_types.items() if dtype == 'datetime']
        self.categorical_columns = [col for col, dtype in self.column_types.items() if dtype == 'object']
        self.column_lower_map = {col.lower(): col for col in self.df.columns}

        # Entity resolution cache
        self._entity_cache = {}
        self._column_synonyms = {
            'id': ['id', 'identifier', 'key', 'code', 'number'],
            'name': ['name', 'title', 'label', 'description'],
            'date': ['date', 'time', 'timestamp', 'created', 'modified', 'order_date', 'sale_date'],
            'amount': ['amount', 'value', 'price', 'cost', 'revenue', 'total'],
            'status': ['status', 'state', 'flag', 'active', 'enabled', 'category']
        }

        self.nim_client = NVIDIA_NIM_Client(
            api_key=NVIDIA_NIM_API_KEY,
            model=NVIDIA_NIM_MODEL,
            endpoint=NVIDIA_NIM_API_ENDPOINT
        )

    def _analyze_column_types(self) -> Dict[str, str]:
        types = {}
        for col in self.df.columns:
            dtype = str(self.df[col].dtype)
            if dtype == 'object':
                try:
                    # FIXED: Removed deprecated 'infer_datetime_format'
                    sample = pd.to_datetime(self.df[col].dropna().head(10), errors='coerce')
                    if sample.notna().sum() > 5:
                        types[col] = 'datetime'
                        self.df[col] = pd.to_datetime(self.df[col], errors='coerce')  # Convert entire column
                        continue
                except Exception:
                    pass
            types[col] = dtype
        return types

    def _generate_system_prompt(self) -> str:
        prompt = f"""
You are an advanced data analysis assistant. Decompose the user's question into a structured query plan.

**Dataset Information:**
- Rows: {len(self.df)}, Columns: {len(self.df.columns)}
- Columns and sample values:
{self._format_column_info()}

**Capabilities:**
- Filter rows by conditions (>, <, =, contains, in)
- Aggregate (sum, avg, count, max, min, std, median)
- Group by columns
- Sort results
- Limit output
- Detect anomalies, trends

**Output Structure (JSON ONLY - no extra text):**
{{
  "intent": "string",
  "parameters": {{}},
  "thought_process": "string",
  "query_plan": [
    {{
      "operation": "filter|aggregate|sort|limit",
      "parameters": {{...}},
      "description": "string"
    }}
  ]
}}

**Rules:**
- ALWAYS output valid JSON.
- DO NOT include any text before or after the JSON.
- If unsure, use intent "general" and empty query_plan.

**Example:**
User: "How many hardware problems are there?"
{{
  "intent": "aggregate",
  "parameters": {{"target_column": "Category", "target_value": "Hardware"}},
  "thought_process": "User wants count of rows where Category is 'Hardware'",
  "query_plan": [
    {{
      "operation": "filter",
      "parameters": {{"column": "Category", "operator": "=", "value": "Hardware"}},
      "description": "Filter to hardware problems"
    }},
    {{
      "operation": "aggregate",
      "parameters": {{"column": "Category", "function": "count"}},
      "description": "Count the filtered rows"
    }}
  ]
}}
        """
        return prompt

    def _format_column_info(self) -> str:
        info_lines = []
        for col in self.df.columns:
            dtype = self.column_types[col]
            sample_values = self.df[col].dropna().head(3).tolist()
            sample_str = ", ".join([str(v)[:50] for v in sample_values[:3]])
            info_lines.append(f"  - {col} ({dtype}): [{sample_str}]")
        return "\n".join(info_lines)

    def _resolve_column_fuzzy(self, name: str) -> Optional[str]:
        if not name:
            return None
        key = f"col_{name.lower()}"
        if key in self._entity_cache:
            return self._entity_cache[key]

        if name in self.df.columns:
            self._entity_cache[key] = name
            return name

        if name.lower() in self.column_lower_map:
            resolved = self.column_lower_map[name.lower()]
            self._entity_cache[key] = resolved
            return resolved

        matches = get_close_matches(name.lower(), [c.lower() for c in self.df.columns], n=1, cutoff=0.6)
        if matches:
            resolved = self.column_lower_map[matches[0]]
            self._entity_cache[key] = resolved
            return resolved

        for canonical, synonyms in self._column_synonyms.items():
            if name.lower() in synonyms:
                for col in self.df.columns:
                    if any(s in col.lower() for s in [canonical] + synonyms):
                        self._entity_cache[key] = col
                        return col

        return None

    def _resolve_value_fuzzy(self, column: str, value: str) -> Any:
        if not column or not value or column not in self.df.columns:
            return value
        unique_vals = self.df[column].dropna().astype(str).unique()
        matches = get_close_matches(str(value), unique_vals, n=1, cutoff=0.7)
        return matches[0] if matches else value

    def _execute_query_plan(self, query_plan: List[Dict], context: Dict = None) -> Dict[str, Any]:
        op_builder = OperationBuilder(self.df)
        errors = []

        for i, step in enumerate(query_plan):
            try:
                op = step.get('operation')
                params = step.get('parameters', {})

                if 'column' in params:
                    resolved_col = self._resolve_column_fuzzy(params['column'])
                    if not resolved_col:
                        errors.append(f"Step {i}: Column '{params['column']}' not found")
                        continue
                    params['column'] = resolved_col

                if op == 'filter':
                    col = params.get('column')
                    op_symbol = params.get('operator')
                    val = params.get('value')

                    if col and op_symbol and val is not None:
                        if col in self.categorical_columns:
                            val = self._resolve_value_fuzzy(col, val)
                        op_builder.add_filter_step(col, op_symbol, val, f"step_{i}")
                    else:
                        errors.append(f"Step {i}: Missing filter parameters")

                elif op == 'aggregate':
                    col = params.get('column')
                    func = params.get('function')
                    group = params.get('group_by')
                    if group:
                        resolved_group = self._resolve_column_fuzzy(group)
                        if resolved_group:
                            group = resolved_group
                        else:
                            errors.append(f"Step {i}: Group column '{group}' not found")
                            continue

                    if col and func:
                        op_builder.add_aggregate_step(col, func, group, f"step_{i}")
                    else:
                        errors.append(f"Step {i}: Missing aggregate parameters")

                elif op == 'sort':
                    col = params.get('column')
                    asc = params.get('ascending', True)
                    if col:
                        op_builder.add_sort_step(col, asc, f"step_{i}")
                    else:
                        errors.append(f"Step {i}: Missing sort column")

                elif op == 'limit':
                    n = params.get('n', 10)
                    op_builder.add_limit_step(n, f"step_{i}")

            except Exception as e:
                errors.append(f"Step {i} setup failed: {str(e)}")

        try:
            result_df, execution_log = op_builder.execute()
            success = all(log.get('success', False) for log in execution_log if 'success' in log)

            return {
                'result_df': result_df,
                'execution_log': execution_log,
                'intermediates': op_builder.intermediates,
                'success': success,
                'errors': errors
            }
        except Exception as e:
            return {
                'result_df': pd.DataFrame(),
                'execution_log': [],
                'intermediates': {},
                'success': False,
                'errors': errors + [f"Execution failed: {str(e)}"]
            }

    def interpret_results_with_llm(self, original_query: str, result_df: pd.DataFrame, execution_log: List[Dict], context: Dict) -> Dict[str, Any]:
        if result_df.empty:
            return {
                'direct_answer': "No results found. Try adjusting your filters or checking column names.",
                'insights': ["The query executed but returned no data."],
                'recommendations': ["Show me sample data.", "List available columns."]
            }

        sample_json = result_df.head(5).to_json(orient='records')
        row_count = len(result_df)

        prompt = f"""
You are a data analyst explaining results to a business user.

**Original Question:**
{original_query}

**Results Summary:**
- {row_count} rows returned
- Columns: {list(result_df.columns)}

**Sample Data (first 3 rows):**
{sample_json}

**Task:**
- Give a direct, concise answer to the user's question.
- Highlight 1-2 key insights.
- Suggest 2 natural follow-up questions.

**Output Structure (JSON ONLY - no extra text):**
{{
  "direct_answer": "string",
  "insights": ["string", "string"],
  "recommendations": ["string?", "string?"]
}}
        """

        try:
            response = self.nim_client.generate_structured_response(prompt, "Interpret these results.")
            return {
                'direct_answer': response.get('direct_answer', f"Query returned {row_count} rows."),
                'insights': response.get('insights', []),
                'recommendations': response.get('recommendations', [])
            }
        except Exception as e:
            return {
                'direct_answer': f"Analysis completed. {row_count} rows match your criteria.",
                'insights': [log['message'] for log in execution_log[:2] if log.get('success')],
                'recommendations': ["Show me all results.", "Export this data."]
            }

    def analyze_query(self, query: str, context: Dict = None) -> Dict[str, Any]:
        context = context or {}
        system_prompt = self._generate_system_prompt()
        llm_response = self.nim_client.generate_structured_response(system_prompt, query)

        intent = llm_response.get('intent', 'general')
        parameters = llm_response.get('parameters', {})
        thought_process = llm_response.get('thought_process', 'No reasoning provided.')
        query_plan = llm_response.get('query_plan', [])

        print(f"[LLM Intent]: {intent}")
        print(f"[Query Plan Steps]: {len(query_plan)}")

        execution_result = self._execute_query_plan(query_plan, context)
        interpretation = self.interpret_results_with_llm(query, execution_result['result_df'], execution_result['execution_log'], context)

        final_response = {
            'direct_answer': interpretation['direct_answer'],
            'insights': [f"Reasoning: {thought_process}"] + interpretation['insights'],
            'analysis': {
                'llm_intent': intent,
                'llm_parameters': parameters,
                'query_plan': query_plan,
                'execution_log': execution_result['execution_log'],
                'errors': execution_result['errors'],
                'row_count': len(execution_result['result_df'])
            },
            'recommendations': interpretation['recommendations'],
            'follow_up_options': interpretation['recommendations'][:3]
        }

        if execution_result['errors']:
            final_response['direct_answer'] = "I encountered some issues: " + "; ".join(execution_result['errors'][:3])
            final_response['insights'].insert(1, "Showing partial results based on successful steps.")

        return final_response

    # --- BACKWARD COMPATIBILITY HANDLERS ---

    def _lookup_row_handler(self, column_name: str, lookup_value: str, target_columns: List[str] = None) -> Dict[str, Any]:
        resolved_col = self._resolve_column_fuzzy(column_name)
        if not resolved_col:
            return {
                'direct_answer': f"Column '{column_name}' not found.",
                'insights': [f"Available: {', '.join(self.df.columns[:5])}..."],
                'analysis': {},
                'recommendations': ["Try rephrasing with exact column name."],
                'follow_up_options': ["List all columns."]
            }

        query_plan = [
            {"operation": "filter", "parameters": {"column": resolved_col, "operator": "contains", "value": lookup_value}, "description": "Lookup record"},
            {"operation": "limit", "parameters": {"n": 1}, "description": "Return first match"}
        ]

        execution_result = self._execute_query_plan(query_plan)
        if execution_result['result_df'].empty:
            return {
                'direct_answer': f"No records found matching '{lookup_value}' in '{resolved_col}'.",
                'insights': [],
                'analysis': execution_result,
                'recommendations': ["Check spelling or try different keywords."],
                'follow_up_options': ["Show sample values for this column."]
            }

        row = execution_result['result_df'].iloc[0]
        target_columns = target_columns or list(self.df.columns)
        valid_targets = [self._resolve_column_fuzzy(c) for c in target_columns if self._resolve_column_fuzzy(c)]
        if not valid_targets:
            valid_targets = list(self.df.columns)

        data = {col: row.get(col, 'N/A') for col in valid_targets}
        parts = [f"{col}: {data[col]}" for col in valid_targets[:5]]
        if len(valid_targets) > 5:
            parts.append("...")

        return {
            'direct_answer': f"Details for '{lookup_value}': " + " | ".join(parts),
            'insights': [f"Found {len(execution_result['result_df'])} matches."],
            'analysis': execution_result,
            'recommendations': ["Show all matching records.", "Export this record."],
            'follow_up_options': [f"Show all for '{lookup_value}'", "What other columns are available?"]
        }

    def _handle_summary_query(self) -> Dict[str, Any]:
        return {
            'direct_answer': f"Dataset contains {len(self.df):,} rows and {len(self.df.columns)} columns.",
            'insights': [
                f"Numeric columns: {len(self.numeric_columns)}",
                f"Categorical columns: {len(self.categorical_columns)}",
                f"Date columns: {len(self.date_columns)}"
            ],
            'analysis': {'shape': self.df.shape},
            'recommendations': ["Show me column statistics.", "Find top values.", "Detect anomalies."],
            'follow_up_options': ["What are the most common values?", "Show me numeric distributions."]
        }

    def _handle_general_query(self, query: str, parameters: Dict = None) -> Dict[str, Any]:
        return {
            'direct_answer': "I can help you explore this data. Try asking something like 'show me top 5 by sales' or 'how many records where status is active'.",
            'insights': [f"Dataset: {len(self.df):,} rows, {len(self.df.columns)} columns"],
            'analysis': {'sample_columns': list(self.df.columns[:5])},
            'recommendations': ["Summarize data.", "Filter by condition.", "Aggregate values."],
            'follow_up_options': ["Give me a summary.", "What columns are available?"]
        }

    # Simple fallbacks for other handlers
    def _handle_filter_query(self, query: str, parameters: Dict = None) -> Dict[str, Any]:
        return self._handle_general_query(query, parameters)

    def _handle_aggregate_query(self, query: str, parameters: Dict = None) -> Dict[str, Any]:
        return self._handle_general_query(query, parameters)

    def _handle_anomaly_query(self, query: str = None) -> Dict[str, Any]:
        if not self.numeric_columns:
            return self._handle_general_query("No numeric columns for anomaly detection", {})
        col = self.numeric_columns[0]
        return self.analyze_query(f"find outliers in {col}")

    def _handle_trend_query(self, query: str = None) -> Dict[str, Any]:
        if not self.date_columns:
            return self._handle_general_query("No date columns for trend analysis", {})
        return self.analyze_query(f"show trend over {self.date_columns[0]}")

    def _handle_comparison_query(self, query: str, parameters: Dict = None) -> Dict[str, Any]:
        return self._handle_general_query(query, parameters)

    def _handle_performance_query(self, query: str, parameters: Dict = None) -> Dict[str, Any]:
        if not self.numeric_columns:
            return self._handle_general_query(query, parameters)
        col = self.numeric_columns[0]
        return self.analyze_query(f"top 5 by {col}")



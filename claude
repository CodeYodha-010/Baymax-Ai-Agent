class SemanticColumnMapper:
    """Maps natural language to actual column names"""
    
    def __init__(self):
        self.column_synonyms = {
            'id': ['identifier', 'code', 'number', 'key', 'ref', 'reference'],
            'name': ['title', 'label', 'description', 'desc'],
            'date': ['time', 'timestamp', 'created', 'updated', 'modified', 'when'],
            'status': ['state', 'condition', 'stage', 'phase'],
            'priority': ['urgency', 'importance', 'level', 'severity', 'criticality'],
            'category': ['type', 'class', 'group', 'kind', 'classification'],
            'team': ['group', 'department', 'unit', 'division', 'squad'],
            'user': ['person', 'assignee', 'owner', 'responsible', 'assigned'],
            'amount': ['value', 'total', 'sum', 'cost', 'price', 'revenue'],
            'count': ['quantity', 'number', 'total', 'num'],
        }
        
        self.term_to_synonym_group = {}
        for main_term, synonyms in self.column_synonyms.items():
            self.term_to_synonym_group[main_term] = main_term
            for synonym in synonyms:
                self.term_to_synonym_group[synonym] = main_term
        
        self.abbreviations = {
            'desc': 'description',
            'cat': 'category',
            'dept': 'department',
            'qty': 'quantity',
            'amt': 'amount',
            'num': 'number',
            'ref': 'reference',
            'id': 'identifier',
            'mgr': 'manager',
            'emp': 'employee',
            'cust': 'customer',
            'prod': 'product',
        }
        
        self.column_metadata = {}
    
    def analyze_columns(self, columns: List[str]) -> Dict[str, Any]:
        """Analyze columns and build semantic mappings"""
        
        metadata = {
            'original_columns': columns,
            'normalized_columns': {},
            'semantic_groups': defaultdict(list),
            'keywords_to_columns': defaultdict(list),
            'abbreviation_map': {},
        }
        
        for col in columns:
            normalized = self._normalize_column_name(col)
            metadata['normalized_columns'][col] = normalized
            
            keywords = self._extract_keywords(col)
            for keyword in keywords:
                metadata['keywords_to_columns'][keyword].append(col)
                
                if keyword in self.term_to_synonym_group:
                    group = self.term_to_synonym_group[keyword]
                    metadata['semantic_groups'][group].append(col)
            
            for abbr, full in self.abbreviations.items():
                if abbr in col.lower():
                    metadata['abbreviation_map'][abbr] = col
        
        self.column_metadata = metadata
        logger.info(f"Analyzed {len(columns)} columns, found {len(metadata['semantic_groups'])} semantic groups")
        
        return metadata
    
    def find_column(self, user_term: str, columns: List[str], 
                   threshold: float = 0.6) -> Optional[Tuple[str, float]]:
        """Find best matching column for user term"""
        
        user_term_lower = user_term.lower().strip()
        
        # 1. Exact match
        for col in columns:
            if col.lower() == user_term_lower:
                logger.debug(f"Exact match: '{user_term}' -> '{col}'")
                return (col, 1.0)
        
        # 2. Check abbreviations
        if user_term_lower in self.abbreviations:
            expanded = self.abbreviations[user_term_lower]
            for col in columns:
                if expanded in col.lower():
                    logger.debug(f"Abbreviation match: '{user_term}' -> '{col}'")
                    return (col, 0.95)
        
        # 3. Semantic group match
        if user_term_lower in self.term_to_synonym_group:
            group = self.term_to_synonym_group[user_term_lower]
            if group in self.column_metadata.get('semantic_groups', {}):
                candidates = self.column_metadata['semantic_groups'][group]
                if candidates:
                    logger.debug(f"Semantic match: '{user_term}' -> '{candidates[0]}' (group: {group})")
                    return (candidates[0], 0.9)
        
        # 4. Keyword match
        keywords_map = self.column_metadata.get('keywords_to_columns', {})
        if user_term_lower in keywords_map:
            candidates = keywords_map[user_term_lower]
            if candidates:
                logger.debug(f"Keyword match: '{user_term}' -> '{candidates[0]}'")
                return (candidates[0], 0.85)
        
        # 5. Fuzzy matching
        best_match = None
        best_score = 0
        
        for col in columns:
            score = fuzz.ratio(user_term_lower, col.lower()) / 100.0
            partial_score = fuzz.partial_ratio(user_term_lower, col.lower()) / 100.0
            token_score = fuzz.token_sort_ratio(user_term_lower, col.lower()) / 100.0
            
            final_score = (score * 0.4 + partial_score * 0.4 + token_score * 0.2)
            
            if final_score > best_score and final_score >= threshold:
                best_score = final_score
                best_match = col
        
        if best_match:
            logger.debug(f"Fuzzy match: '{user_term}' -> '{best_match}' (score: {best_score:.2f})")
            return (best_match, best_score)
        
        return None
    
    def _normalize_column_name(self, col: str) -> str:
        """Normalize column name for matching"""
        normalized = re.sub(r'[_\-\s]+', ' ', col.lower())
        normalized = re.sub(r'[^a-z0-9\s]', '', normalized)
        return normalized.strip()
    
    def _extract_keywords(self, col: str) -> List[str]:
        """Extract meaningful keywords from column name"""
        parts = re.split(r'[_\-\s]+', col.lower())
        
        keywords = []
        for part in parts:
            cleaned = re.sub(r'(s|es|ed|ing)$', '', part)
            if len(cleaned) > 2:
                keywords.append(cleaned)
        
        return keywords


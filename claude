class EnhancedLLMInspiredQueryAnalyzer(LLMInspiredQueryAnalyzer):
    """Enhanced analyzer with all five phases integrated"""
    
    def __init__(self):
        super().__init__()
        
        self.column_mapper = SemanticColumnMapper()
        self.value_engine = SmartValueInferenceEngine()
        self.query_decomposer = CompoundQueryDecomposer(self.column_mapper, self.value_engine)
        self.memory_system = ContextualMemorySystem()
        self.domain_detector = DomainDetector()
        
        self.data_analyzed = False
        self.data_context = {}
        self.current_df = None
    
    def analyze_data(self, df: pd.DataFrame) -> Dict[str, Any]:
        """Analyze dataframe structure and content"""
        
        logger.info("Analyzing dataframe structure...")
        
        self.current_df = df
        
        column_metadata = self.column_mapper.analyze_columns(df.columns.tolist())
        value_profiles = self.value_engine.profile_dataframe(df)
        domain, domain_confidence = self.domain_detector.detect_domain(df)
        
        self.data_context = {
            'columns': column_metadata,
            'profiles': value_profiles,
            'domain': domain,
            'domain_confidence': domain_confidence,
            'shape': df.shape,
        }
        
        self.data_analyzed = True
        
        return self.data_context
    
    def analyze(self, query: str, df_or_columns) -> QueryContext:
        """Enhanced analyze with all phases
        
        Args:
            query: The query string
            df_or_columns: Either a DataFrame or list of column names
        """
        
        # Determine if we received DataFrame or columns list
        if isinstance(df_or_columns, pd.DataFrame):
            df = df_or_columns
            df_columns = df.columns.tolist()
            
            # Analyze data if not already done
            if not self.data_analyzed or self.current_df is not df:
                self.analyze_data(df)
        else:
            # It's a list of columns
            df_columns = df_or_columns
            df = self.current_df  # Use stored DataFrame if available
        
        logger.info(f"=== Enhanced Analysis for: '{query}' ===")
        
        # Phase 4: Reference resolution
        resolved_query = query
        references = ['that', 'this', 'those', 'these', 'similar', 'other']
        for ref in references:
            if ref in query.lower():
                resolution = self.memory_system.resolve_reference(ref, query)
                if resolution:
                    resolved_query = query.replace(ref, resolution)
                    logger.info(f"Resolved reference '{ref}' to '{resolution}'")
        
        # Phase 5: Domain rules
        domain_rules = {}
        if df is not None:
            domain_rules = self.domain_detector.apply_domain_rules(resolved_query, df)
            if domain_rules.get('transformations'):
                logger.info(f"Applied domain rules: {domain_rules['transformations']}")
        
        # Call parent analyzer with columns list
        context = super().analyze(resolved_query, df_columns)
        
        # Phase 3: Compound query decomposition
        if df is not None and any(op in resolved_query.lower() for op in ['and', 'or', 'with', 'having']):
            compound = self.query_decomposer.decompose(resolved_query, df)
            context.filters = {
                'compound': compound,
                'conditions': compound.conditions
            }
            logger.info(f"Decomposed into {len(compound.conditions)} conditions")
        
        # Phase 1: Enhanced entity extraction
        enhanced_entities = []
        for entity in context.entities:
            if entity.entity_type == 'column':
                match = self.column_mapper.find_column(entity.text, df_columns)
                if match:
                    entity.text = match[0]
                    entity.confidence = match[1]
            enhanced_entities.append(entity)
        
        context.entities = enhanced_entities
        
        # Store in memory
        memory = QueryMemory(
            query=query,
            timestamp=datetime.now(),
            intent=context.selected_intent.name,
            entities=context.entities,
            results={},
            successful=False,
            mappings={}
        )
        self.memory_system.add_query(memory)
        
        # Add context hints
        context.context_hints = self.memory_system.get_context_hints()
        context.domain_context = domain_rules
        
        return context


def validate_and_clean_data(df):
    """Validate and clean DataFrame to prevent serialization issues"""
    if df is None or df.empty:
        return df
    
    # Replace infinity values with NaN
    df = df.replace([np.inf, -np.inf], np.nan)
    
    # For object columns, ensure no bytes or other problematic types
    for col in df.select_dtypes(include=['object']).columns:
        df[col] = df[col].apply(lambda x: x.decode('utf-8', errors='ignore') if isinstance(x, bytes) else x)
    
    return df


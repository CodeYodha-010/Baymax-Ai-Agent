class UploadFileView(View):
    def get(self, request):
        if request.session.session_key:
            cache.delete(f"df_{request.session.session_key}")
            cache.delete(f"metadata_{request.session.session_key}")
        return render(request, 'upload.html')

    def post(self, request):
        if request.content_type == 'application/json':
            return JsonResponse({'status': 'error', 'message': 'Expecting file upload'}, status=400)

        if 'data_file' not in request.FILES:
            return JsonResponse({'status': 'error', 'message': 'No file provided'}, status=400)

        file = request.FILES['data_file']
        if file.size > 100 * 1024 * 1024:
            return JsonResponse({'status': 'error', 'message': 'File too large'}, status=400)

        try:
            file_extension = os.path.splitext(file.name)[1].lower()
            if file_extension == '.csv':
                encodings = ['utf-8', 'latin-1', 'iso-8859-1', 'cp1252']
                df = None
                for encoding in encodings:
                    try:
                        file.seek(0)
                        df = pd.read_csv(file, encoding=encoding)
                        break
                    except UnicodeDecodeError:
                        continue
                if df is None:
                    raise ValueError("Could not decode file")
            elif file_extension in ['.xlsx', '.xls']:
                file.seek(0)
                df = pd.read_excel(file)
            else:
                return JsonResponse({'status': 'error', 'message': 'Unsupported format'}, status=400)

            if df.empty or len(df.columns) == 0:
                return JsonResponse({'status': 'error', 'message': 'Empty file'}, status=400)

            df.columns = df.columns.str.strip()
            if not request.session.session_key:
                request.session.create()
            session_id = request.session.session_key

            df_json = df.to_json(date_format='iso', orient='split')
            cache.set(f"df_{session_id}", df_json, 3600)

            metadata = {
                'filename': file.name,
                'rows': len(df),
                'columns': len(df.columns),
                'column_names': list(df.columns),
                'upload_time': datetime.now().isoformat(),
                'file_size': file.size
            }
            cache.set(f"metadata_{session_id}", metadata, 3600)

            context_manager = ContextManager(session_id)
            context_manager.update_context(f"Uploaded {file.name}", {'direct_answer': f"Loaded {len(df)} rows"})

            response_data = {'status': 'success', 'message': 'Uploaded', 'redirect_url': '/ask/'}
            return JsonResponse(response_data) if request.headers.get('X-Requested-With') == 'XMLHttpRequest' else redirect('ask')

        except Exception as e:
            return JsonResponse({'status': 'error', 'message': f'Error: {str(e)}'}, status=500)


@method_decorator(csrf_exempt, name='dispatch')
class AskQuestionView(View):
    def get(self, request):
        session_id = request.session.session_key
        if not session_id:
            return redirect('upload')
        metadata = cache.get(f"metadata_{session_id}")
        df_json = cache.get(f"df_{session_id}")
        if not metadata or not df_json:
            return redirect('upload')
        try:
            df = pd.read_json(io.StringIO(df_json), orient='split')
        except Exception as e:
            return JsonResponse({'status': 'error', 'message': str(e)}, status=500)

        context = {
            'file_name': metadata['filename'],
            'row_count': metadata['rows'],
            'columns': metadata['column_names'],
            'sample_data': df.head(5).to_dict('records')
        }
        return render(request, 'ask.html', context)

    def post(self, request):
        try:
            session_id = request.session.session_key
            if not session_id:
                return JsonResponse({'status': 'error', 'message': 'No session'}, status=400)

            data = json.loads(request.body)
            query = data.get('query', '').strip()
            if not query:
                return JsonResponse({'status': 'error', 'message': 'No query'}, status=400)

            df_json = cache.get(f"df_{session_id}")
            if not df_json:
                return JsonResponse({'status': 'error', 'message': 'Session expired'}, status=400)

            df = pd.read_json(io.StringIO(df_json), orient='split')
            table_agent = TableAgent(df)
            context_manager = ContextManager(session_id)
            context = context_manager.get_context()

            result = table_agent.analyze_query(query, context)

            response_data = {
                'status': 'success',
                'results': {
                    'summary': result.get('direct_answer', ''),
                    'insights': result.get('insights', []),
                    'recommendations': result.get('recommendations', [])
                },
                'suggested_followups': result.get('follow_up_options', [])
            }

            context_manager.update_context(query, result)
            return JsonResponse(response_data)

        except Exception as e:
            import traceback
            traceback.print_exc()
            return JsonResponse({'status': 'error', 'message': str(e)}, status=500)



class SmartValueInferenceEngine:
    """Maps natural language values to actual data values"""
    
    def __init__(self):
        self.column_profiles = {}
        
        self.value_mappings = {
            'priority': {
                'high': ['critical', 'urgent', 'high', 'p1', '1', 'severe'],
                'medium': ['medium', 'normal', 'moderate', 'p2', '2'],
                'low': ['low', 'minor', 'p3', '3', 'trivial'],
            },
            'status': {
                'open': ['open', 'active', 'pending', 'new', 'in progress', 'ongoing'],
                'closed': ['closed', 'resolved', 'completed', 'done', 'finished'],
                'cancelled': ['cancelled', 'abandoned', 'dropped', 'void'],
            },
            'boolean': {
                'yes': ['yes', 'y', 'true', '1', 'enabled', 'active'],
                'no': ['no', 'n', 'false', '0', 'disabled', 'inactive'],
            },
            'size': {
                'large': ['large', 'big', 'huge', 'major', 'xl', 'xxl'],
                'medium': ['medium', 'moderate', 'average', 'm', 'mid'],
                'small': ['small', 'tiny', 'minor', 's', 'xs'],
            }
        }
        
        self.temporal_mappings = {
            'recent': lambda: datetime.now() - timedelta(days=30),
            'today': lambda: datetime.now().date(),
            'yesterday': lambda: datetime.now().date() - timedelta(days=1),
            'this week': lambda: datetime.now() - timedelta(days=7),
            'this month': lambda: datetime.now() - timedelta(days=30),
            'last month': lambda: datetime.now() - timedelta(days=60),
            'this year': lambda: datetime.now() - timedelta(days=365),
        }
    
    def profile_column(self, df: pd.DataFrame, column: str) -> Dict[str, Any]:
        """Profile a column to understand its value distribution"""
        
        profile = {
            'column': column,
            'dtype': str(df[column].dtype),
            'unique_count': df[column].nunique(),
            'null_count': df[column].isnull().sum(),
            'sample_values': [],
        }
        
        if pd.api.types.is_numeric_dtype(df[column]):
            profile['column_type'] = 'numeric'
            profile['stats'] = {
                'min': float(df[column].min()),
                'max': float(df[column].max()),
                'mean': float(df[column].mean()),
                'median': float(df[column].median()),
                'std': float(df[column].std()),
                'q25': float(df[column].quantile(0.25)),
                'q75': float(df[column].quantile(0.75)),
            }
            
        elif pd.api.types.is_datetime64_any_dtype(df[column]):
            profile['column_type'] = 'datetime'
            profile['date_range'] = {
                'min': df[column].min().isoformat() if pd.notna(df[column].min()) else None,
                'max': df[column].max().isoformat() if pd.notna(df[column].max()) else None,
            }
            
        else:
            profile['column_type'] = 'categorical'
            value_counts = df[column].value_counts()
            profile['value_distribution'] = value_counts.head(20).to_dict()
            profile['sample_values'] = value_counts.index[:10].tolist()
            
            profile['is_ordinal'] = self._detect_ordinal(value_counts.index.tolist())
        
        return profile
    
    def profile_dataframe(self, df: pd.DataFrame) -> Dict[str, Any]:
        """Profile entire dataframe"""
        
        profiles = {}
        for column in df.columns:
            try:
                profiles[column] = self.profile_column(df, column)
            except Exception as e:
                logger.warning(f"Error profiling column {column}: {e}")
                profiles[column] = {'error': str(e)}
        
        self.column_profiles = profiles
        return profiles
    
    def infer_value(self, user_value: str, column: str, df: pd.DataFrame) -> Tuple[Any, float]:
        """Infer actual data value from natural language"""
        
        user_value_lower = user_value.lower().strip()
        
        if column not in self.column_profiles:
            self.column_profiles[column] = self.profile_column(df, column)
        
        profile = self.column_profiles[column]
        
        if profile.get('column_type') == 'numeric':
            return self._infer_numeric_value(user_value_lower, profile, df[column])
        
        elif profile.get('column_type') == 'datetime':
            return self._infer_datetime_value(user_value_lower, profile)
        
        else:
            return self._infer_categorical_value(user_value_lower, profile, df[column])
    
    def _infer_numeric_value(self, user_value: str, profile: Dict, series: pd.Series) -> Tuple[Any, float]:
        """Infer numeric value or range"""
        
        stats = profile.get('stats', {})
        
        relative_mappings = {
            'high': lambda: stats.get('q75', 0),
            'low': lambda: stats.get('q25', 0),
            'average': lambda: stats.get('mean', 0),
            'median': lambda: stats.get('median', 0),
            'maximum': lambda: stats.get('max', 0),
            'minimum': lambda: stats.get('min', 0),
            'above average': lambda: ('>', stats.get('mean', 0)),
            'below average': lambda: ('<', stats.get('mean', 0)),
        }
        
        for term, func in relative_mappings.items():
            if term in user_value:
                result = func()
                if isinstance(result, tuple):
                    return result, 0.8
                return result, 0.8
        
        try:
            return float(user_value), 1.0
        except:
            pass
        
        percentile_match = re.search(r'top\s*(\d+)%?', user_value)
        if percentile_match:
            pct = float(percentile_match.group(1))
            threshold = series.quantile(1 - pct/100)
            return ('>', threshold), 0.85
        
        return None, 0.0
    
    def _infer_datetime_value(self, user_value: str, profile: Dict) -> Tuple[Any, float]:
        """Infer datetime value or range"""
        
        for term, func in self.temporal_mappings.items():
            if term in user_value:
                return func(), 0.9
        
        try:
            return pd.to_datetime(user_value), 1.0
        except:
            pass
        
        return None, 0.0
    
    def _infer_categorical_value(self, user_value: str, profile: Dict, series: pd.Series) -> Tuple[Any, float]:
        """Infer categorical value"""
        
        if 'sample_values' in profile:
            for actual_value in profile['sample_values']:
                if str(actual_value).lower() == user_value:
                    return actual_value, 1.0
        
        col_lower = profile.get('column', '').lower()
        for mapping_type, mappings in self.value_mappings.items():
            if mapping_type in col_lower:
                for key, values in mappings.items():
                    if user_value in values:
                        for actual_value in series.unique():
                            if pd.notna(actual_value):
                                actual_lower = str(actual_value).lower()
                                if any(v in actual_lower for v in values):
                                    return actual_value, 0.9
        
        unique_values = series.dropna().unique()
        if len(unique_values) < 1000:
            best_match = process.extractOne(
                user_value,
                [str(v) for v in unique_values],
                scorer=fuzz.ratio
            )
            if best_match and best_match[1] > 70:
                return best_match[0], best_match[1] / 100.0
        
        return None, 0.0
    
    def _detect_ordinal(self, values: List[str]) -> bool:
        """Detect if values represent ordinal data"""
        
        ordinal_patterns = [
            ['low', 'medium', 'high'],
            ['small', 'medium', 'large'],
            ['1', '2', '3', '4', '5'],
            ['p1', 'p2', 'p3'],
            ['critical', 'high', 'medium', 'low'],
        ]
        
        values_lower = [str(v).lower() for v in values[:10]]
        
        for pattern in ordinal_patterns:
            matches = sum(1 for p in pattern if any(p in v for v in values_lower))
            if matches >= len(pattern) * 0.6:
                return True
        
        return False


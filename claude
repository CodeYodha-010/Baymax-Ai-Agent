class DataAnalysisCache:
    """Cache for AI responses"""
    
    def get_cache_key(self, query: str, data_hash: str) -> str:
        query_hash = hashlib.md5(query.encode()).hexdigest()
        return f"nvidia_nim_{data_hash}_{query_hash}"
    
    def get(self, query: str, data_hash: str) -> Optional[Dict]:
        key = self.get_cache_key(query, data_hash)
        return cache.get(key)
    
    def set(self, query: str, data_hash: str, response: Dict):
        key = self.get_cache_key(query, data_hash)
        cache.set(key, response, AI_CACHE_DURATION)


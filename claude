        if query_type == 'lookup':
            if result.get('has_data'):
                suggestions.extend([
                    "Find similar records",
                    "Compare with other IDs",
                    "Show related statistics"
                ])
            else:
                suggestions.extend([
                    "Try different ID format",
                    "Show all available IDs",
                    "Search by other criteria"
                ])
        
        elif query_type == 'count':
            suggestions.extend([
                "Show the actual records",
                "Break down by categories",
                "Compare different groups"
            ])
        
        elif query_type == 'statistics':
            suggestions.extend([
                "Show raw data",
                "Compare columns",
                "Find outliers"
            ])
        
        elif query_type in ['search', 'filter']:
            if result.get('row_count', 0) > 0:
                suggestions.extend([
                    "Analyze these results",
                    "Group by category",
                    "Show statistics"
                ])
            else:
                suggestions.extend([
                    "Try broader search",
                    "Check spelling",
                    "Show all data"
                ])
        
        return suggestions[:3]


class EnhancedIntelligentQueryProcessor(IntelligentQueryProcessor):
    """Main processor with all enhancements"""
    
    def __init__(self):
        super().__init__()
        self.executor = EnhancedSmartQueryExecutor()
    
    async def process_query(self, query: str, df: pd.DataFrame,
                           data_context: Dict[str, Any]) -> Dict[str, Any]:
        """Process with full enhancement pipeline"""
        
        try:
            if not self.executor.analyzer.data_analyzed:
                analysis_context = self.executor.analyzer.analyze_data(df)
                data_context.update(analysis_context)
            
            result = await self.executor.execute(query, df, data_context)
            
            result['suggestions'] = self._generate_enhanced_suggestions(result, query, df)
            
            result['learning'] = {
                'terms_learned': len(self.executor.analyzer.memory_system.term_mappings),
                'domain': self.executor.analyzer.domain_detector.detected_domain,
                'confidence_boost': self._calculate_confidence_boost()
            }
            
            result['query_executed'] = True
            result['timestamp'] = datetime.now().isoformat()
            
            return result
            
        except Exception as e:
            logger.error(f"Error in enhanced processing: {e}\n{traceback.format_exc()}")
            return await super().process_query(query, df, data_context)
    
    def _generate_enhanced_suggestions(self, result: Dict[str, Any], 
                                      query: str, df: pd.DataFrame) -> List[str]:
        """Generate intelligent suggestions"""
        
        suggestions = self._generate_suggestions(result, query)
        
        domain = self.executor.analyzer.domain_detector.detected_domain
        
        if domain == 'it_support':
            suggestions.extend([
                "Show critical issues",
                "Group by priority",
                "Find unassigned tickets"
            ])
        elif domain == 'sales':
            suggestions.extend([
                "Show this quarter's performance",
                "Compare with last month",
                "Top performing products"
            ])
        elif domain == 'hr':
            suggestions.extend([
                "Department breakdown",
                "Salary statistics",
                "Recent hires"
            ])
        
        if self.executor.analyzer.memory_system.query_history:
            last_query = self.executor.analyzer.memory_system.query_history[-1]
            if last_query.intent == 'lookup':
                suggestions.append("Find similar records")
            elif last_query.intent == 'statistics':
                suggestions.append("Show the raw data")
        
        return list(set(suggestions))[:5]
    
    def _calculate_confidence_boost(self) -> float:
        """Calculate confidence improvement from learning"""
        
        memory = self.executor.analyzer.memory_system
        if len(memory.query_history) < 2:
            return 0.0
        
        recent_success = sum(1 for q in memory.query_history[-3:] if q.successful)
        early_success = sum(1 for q in memory.query_history[:3] if q.successful)
        
        if early_success == 0:
            return 1.0 if recent_success > 0 else 0.0
        
        return (recent_success - early_success) / early_success


class ContextManager:
    def __init__(self, session_id: str):
        self.session_id = session_id
        self.cache_key = f"context_{session_id}"
        self.max_history = 20

    def get_context(self) -> Dict[str, Any]:
        default = {'history': [], 'last_query': None, 'query_count': 0}
        return cache.get(self.cache_key, default)

    def update_context(self, query: str, response: Dict[str, Any]):
        context = self.get_context()
        context['query_count'] += 1
        context['last_query'] = query
        context['history'].append({
            'timestamp': datetime.now().isoformat(),
            'query': query,
            'response_summary': response.get('direct_answer', '')[:200],
            'success': not response.get('analysis', {}).get('errors')
        })
        context['history'] = context['history'][-self.max_history:]
        cache.set(self.cache_key, context, 3600)

    def clear_context(self):
        cache.delete(self.cache_key)
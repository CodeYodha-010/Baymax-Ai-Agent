# PHASE 3: COMPOUND QUERY DECOMPOSITION
# =====================================================================

class CompoundQueryDecomposer:
    """Decomposes complex queries into atomic conditions"""
    
    def __init__(self, column_mapper: SemanticColumnMapper, value_engine: SmartValueInferenceEngine):
        self.column_mapper = column_mapper
        self.value_engine = value_engine
        
        self.and_terms = ['and', 'with', 'having', 'that have', 'where', 'also']
        self.or_terms = ['or', 'either', 'alternatively']
        self.not_terms = ['not', 'except', 'without', 'excluding', 'but not']
        
        self.operators = {
            'equals': ['is', 'equals', '=', 'equal to'],
            'not_equals': ['is not', 'not equal', '!=', 'different from'],
            'greater': ['greater than', 'more than', '>', 'above', 'over'],
            'less': ['less than', 'below', '<', 'under'],
            'contains': ['contains', 'includes', 'has', 'with'],
            'between': ['between', 'from...to', 'in range'],
        }
    
    def decompose(self, query: str, df: pd.DataFrame) -> CompoundQuery:
        """Decompose query into conditions"""
        
        logger.info(f"Decomposing query: {query}")
        
        segments = self._split_by_operators(query)
        
        conditions = []
        logical_ops = []
        
        for segment in segments:
            condition = self._parse_condition(segment['text'], df)
            if condition:
                conditions.append(condition)
                if segment['operator']:
                    logical_ops.append(segment['operator'])
        
        return CompoundQuery(
            conditions=conditions,
            logical_operators=logical_ops,
            raw_query=query
        )
    
    def _split_by_operators(self, query: str) -> List[Dict]:
        """Split query by logical operators"""
        
        segments = []
        current_segment = []
        current_operator = None
        
        words = query.split()
        i = 0
        
        while i < len(words):
            word_lower = words[i].lower()
            
            found_operator = None
            
            if i < len(words) - 1:
                two_word = f"{word_lower} {words[i+1].lower()}"
                if two_word in self.not_terms:
                    found_operator = 'NOT'
                    i += 1
            
            if not found_operator:
                if word_lower in self.and_terms:
                    found_operator = 'AND'
                elif word_lower in self.or_terms:
                    found_operator = 'OR'
                elif word_lower in self.not_terms:
                    found_operator = 'NOT'
            
            if found_operator and current_segment:
                segments.append({
                    'text': ' '.join(current_segment),
                    'operator': current_operator
                })
                current_segment = []
                current_operator = found_operator
            else:
                current_segment.append(words[i])
            
            i += 1
        
        if current_segment:
            segments.append({
                'text': ' '.join(current_segment),
                'operator': current_operator
            })
        
        return segments
    
    def _parse_condition(self, text: str, df: pd.DataFrame) -> Optional[QueryCondition]:
        """Parse a single condition from text"""
        
        column = None
        operator = '='
        value = None
        confidence = 0.5
        
        patterns = [
            r'(\w+)\s+(is|equals?|=|>|<|contains?)\s+(.+)',
            r'(\w+)\s+(.+)',
            r'(.+)\s+(?:from|in|of)\s+(\w+)',
        ]
        
        for pattern in patterns:
            match = re.search(pattern, text, re.IGNORECASE)
            if match:
                groups = match.groups()
                
                for group in groups:
                    col_match = self.column_mapper.find_column(group, df.columns.tolist())
                    if col_match:
                        column = col_match[0]
                        confidence = col_match[1]
                        
                        for other_group in groups:
                            if other_group != group:
                                value = other_group
                                break
                        break
                
                if column and value:
                    break
        
        if not column or not value:
            return None
        
        for op_type, op_terms in self.operators.items():
            if any(term in text.lower() for term in op_terms):
                operator = {
                    'equals': '=',
                    'not_equals': '!=',
                    'greater': '>',
                    'less': '<',
                    'contains': 'contains',
                    'between': 'between',
                }[op_type]
                break
        
        inferred_value, value_confidence = self.value_engine.infer_value(value, column, df)
        if inferred_value is not None:
            value = inferred_value
            confidence = (confidence + value_confidence) / 2
        
        return QueryCondition(
            column=column,
            operator=operator,
            value=value,
            confidence=confidence,
            raw_text=text
        )

# =====================================================================
# PHASE 4: CONTEXTUAL MEMORY SYSTEM
# =====================================================================

class ContextualMemorySystem:
    """Maintains context across queries"""
    
    def __init__(self, max_history: int = 10):
        self.max_history = max_history
        self.query_history: List[QueryMemory] = []
        self.current_context = {}
        self.term_mappings = {}
        self.entity_cache = {}
        
    def add_query(self, memory: QueryMemory):
        """Add query to history"""
        self.query_history.append(memory)
        
        if memory.successful:
            self.current_context['last_successful_query'] = memory
            
            for user_term, actual_term in memory.mappings.items():
                if user_term not in self.term_mappings:
                    self.term_mappings[user_term] = {}
                    
                if actual_term not in self.term_mappings[user_term]:
                    self.term_mappings[user_term][actual_term] = 0
                    
                self.term_mappings[user_term][actual_term] += 1
            
            for entity in memory.entities:
                self.entity_cache[entity.text] = entity
        
        if len(self.query_history) > self.max_history:
            self.query_history.pop(0)
    
    def resolve_reference(self, reference: str, current_query: str) -> Optional[str]:
        """Resolve contextual references"""
        
        reference_lower = reference.lower()
        
        if reference_lower in ['that', 'this', 'it']:
            if self.query_history:
                last_query = self.query_history[-1]
                if last_query.entities:
                    return last_query.entities[0].text
        
        elif reference_lower in ['those', 'these', 'them']:
            if 'last_successful_query' in self.current_context:
                last_query = self.current_context['last_successful_query']
                if 'ids_found' in last_query.results:
                    return ' '.join(last_query.results['ids_found'])
        
        elif reference_lower in ['similar', 'related', 'like that']:
            if self.query_history:
                last_query = self.query_history[-1]
                if last_query.entities:
                    return f"similar to {last_query.entities[0].text}"
        
        elif reference_lower in ['other', 'others', 'rest']:
            if 'last_successful_query' in self.current_context:
                last_query = self.current_context['last_successful_query']
                return f"not {last_query.query}"
        
        return None
    
    def get_learned_mapping(self, user_term: str) -> Optional[str]:
        """Get most likely mapping for user term"""
        
        if user_term in self.term_mappings:
            mappings = self.term_mappings[user_term]
            return max(mappings.items(), key=lambda x: x[1])[0]
        
        return None
    
    def get_context_hints(self) -> Dict[str, Any]:
        """Get hints from context"""
        
        hints = {
            'recent_entities': list(self.entity_cache.keys())[:5],
            'learned_terms': list(self.term_mappings.keys()),
            'last_query_type': None,
            'session_patterns': []
        }
        
        if self.query_history:
            intent_counts = Counter(q.intent for q in self.query_history)
            hints['session_patterns'] = intent_counts.most_common(3)
            hints['last_query_type'] = self.query_history[-1].intent
        
        return hints


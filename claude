class DomainDetector:
    """Detects and applies domain-specific logic"""
    
    def __init__(self):
        self.domain_indicators = {
            'it_support': {
                'columns': ['ticket', 'issue', 'problem', 'bug', 'error', 'assignee', 'priority', 'severity'],
                'values': ['open', 'closed', 'resolved', 'critical', 'bug', 'feature'],
                'weight': 0
            },
            'sales': {
                'columns': ['revenue', 'sales', 'customer', 'product', 'quota', 'commission', 'deal'],
                'values': ['prospect', 'lead', 'opportunity', 'closed-won', 'pipeline'],
                'weight': 0
            },
            'hr': {
                'columns': ['employee', 'salary', 'department', 'manager', 'performance', 'hire', 'termination'],
                'values': ['full-time', 'part-time', 'contractor', 'performance review'],
                'weight': 0
            },
            'finance': {
                'columns': ['transaction', 'amount', 'debit', 'credit', 'balance', 'account', 'invoice'],
                'values': ['paid', 'pending', 'overdue', 'reconciled'],
                'weight': 0
            },
            'inventory': {
                'columns': ['product', 'stock', 'quantity', 'warehouse', 'sku', 'inventory'],
                'values': ['in-stock', 'out-of-stock', 'backorder', 'reorder'],
                'weight': 0
            }
        }
        
        self.domain_rules = {
            'it_support': {
                'default_filters': {'status': ['open', 'in progress']},
                'priority_order': ['critical', 'high', 'medium', 'low'],
                'synonyms': {
                    'bug': ['defect', 'issue', 'problem', 'error'],
                    'ticket': ['case', 'issue', 'request', 'incident']
                }
            },
            'sales': {
                'default_filters': {'status': ['active', 'open']},
                'time_periods': {
                    'quarter': 90,
                    'month': 30,
                    'week': 7
                },
                'synonyms': {
                    'revenue': ['sales', 'income', 'earnings'],
                    'customer': ['client', 'account', 'buyer']
                }
            },
            'hr': {
                'default_filters': {'employment_status': ['active']},
                'synonyms': {
                    'employee': ['staff', 'worker', 'personnel'],
                    'manager': ['supervisor', 'boss', 'lead']
                }
            }
        }
        
        self.detected_domain = None
        self.domain_confidence = 0.0
    
    def detect_domain(self, df: pd.DataFrame) -> Tuple[str, float]:
        """Detect domain from dataframe structure"""
        
        for domain in self.domain_indicators.values():
            domain['weight'] = 0
        
        columns_lower = [col.lower() for col in df.columns]
        
        for domain_name, indicators in self.domain_indicators.items():
            for indicator_col in indicators['columns']:
                for col in columns_lower:
                    if indicator_col in col:
                        indicators['weight'] += 2
        
        sample_data = df.head(100)
        
        for domain_name, indicators in self.domain_indicators.items():
            for col in sample_data.select_dtypes(include=['object']).columns:
                try:
                    unique_values = sample_data[col].dropna().unique()
                    for value in unique_values[:20]:
                        value_lower = str(value).lower()
                        for indicator_val in indicators['values']:
                            if indicator_val in value_lower:
                                indicators['weight'] += 1
                except:
                    pass
        
        best_domain = None
        best_weight = 0
        
        for domain_name, indicators in self.domain_indicators.items():
            if indicators['weight'] > best_weight:
                best_weight = indicators['weight']
                best_domain = domain_name
        
        total_possible = len(df.columns) * 2 + 20
        confidence = min(best_weight / total_possible * 2, 1.0) if best_domain else 0.0
        
        self.detected_domain = best_domain
        self.domain_confidence = confidence
        
        logger.info(f"Detected domain: {best_domain} (confidence: {confidence:.2f})")
        
        return best_domain, confidence
    
    def apply_domain_rules(self, query: str, df: pd.DataFrame) -> Dict[str, Any]:
        """Apply domain-specific rules to query"""
        
        if not self.detected_domain or self.domain_confidence < 0.5:
            return {}
        
        rules = self.domain_rules.get(self.detected_domain, {})
        
        applied_rules = {
            'domain': self.detected_domain,
            'confidence': self.domain_confidence,
            'filters': {},
            'transformations': []
        }
        
        if 'default_filters' in rules:
            for col, default_values in rules['default_filters'].items():
                if col not in query.lower():
                    applied_rules['filters'][col] = default_values
                    applied_rules['transformations'].append(
                        f"Applied default filter: {col} in {default_values}"
                    )
        
        if 'synonyms' in rules:
            for main_term, synonyms in rules['synonyms'].items():
                for synonym in synonyms:
                    if synonym in query.lower():
                        query = query.replace(synonym, main_term)
                        applied_rules['transformations'].append(
                            f"Replaced '{synonym}' with '{main_term}'"
                        )
        
        return applied_rules


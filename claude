class SafeJSONEncoder(json.JSONEncoder):
    """Custom JSON encoder that handles all problematic types"""
    
    def default(self, obj):
        try:
            # Handle numpy types
            if isinstance(obj, np.integer):
                return int(obj)
            elif isinstance(obj, np.floating):
                # Check for NaN or Infinity
                if np.isnan(obj):
                    return None
                elif np.isinf(obj):
                    return None
                return float(obj)
            elif isinstance(obj, np.bool_):
                return bool(obj)
            elif isinstance(obj, np.ndarray):
                return self.clean_list(obj.tolist())
            
            # Handle pandas types
            elif pd.api.types.is_scalar(obj) and pd.isna(obj):
                return None
            elif isinstance(obj, pd.DataFrame):
                return self.clean_dataframe(obj)
            elif isinstance(obj, pd.Series):
                return self.clean_list(obj.tolist())
            elif isinstance(obj, pd.Timestamp):
                return obj.isoformat()
            elif isinstance(obj, pd.NaT.__class__):
                return None
            
            # Handle datetime
            elif isinstance(obj, (datetime, pd.Timestamp)):
                return obj.isoformat()
            elif isinstance(obj, timedelta):
                return obj.total_seconds()
            
            # Handle Decimal
            elif isinstance(obj, Decimal):
                return float(obj)
            
            # Handle bytes
            elif isinstance(obj, bytes):
                return obj.decode('utf-8', errors='ignore')
            
            # Default
            return super().default(obj)
            
        except Exception as e:
            logger.debug(f"Serialization fallback for {type(obj)}: {e}")
            return str(obj)
    
    def clean_value(self, value):
        """Clean a single value for JSON serialization"""
        if value is None:
            return None
        
        # Check for NaN in various forms
        try:
            if isinstance(value, float):
                if math.isnan(value) or math.isinf(value):
                    return None
            elif isinstance(value, np.floating):
                if np.isnan(value) or np.isinf(value):
                    return None
            elif pd.isna(value):
                return None
        except:
            pass
        
        # Handle numpy types
        if isinstance(value, np.integer):
            return int(value)
        elif isinstance(value, np.floating):
            return None if np.isnan(value) or np.isinf(value) else float(value)
        elif isinstance(value, np.bool_):
            return bool(value)
        elif isinstance(value, np.ndarray):
            return self.clean_list(value.tolist())
        
        # Handle pandas types
        elif isinstance(value, pd.Timestamp):
            return value.isoformat()
        elif isinstance(value, pd.Series):
            return self.clean_list(value.tolist())
        elif isinstance(value, pd.DataFrame):
            return self.clean_dataframe(value)
        
        # Handle basic types
        elif isinstance(value, (str, int, bool)):
            return value
        elif isinstance(value, float):
            if math.isnan(value) or math.isinf(value):
                return None
            return value
        elif isinstance(value, dict):
            return self.clean_dict(value)
        elif isinstance(value, (list, tuple)):
            return self.clean_list(value)
        elif isinstance(value, set):
            return self.clean_list(list(value))
        
        # Convert everything else to string
        return str(value)
    
    def clean_dict(self, d):
        """Clean dictionary for JSON serialization"""
        cleaned = {}
        for key, value in d.items():
            cleaned[str(key)] = self.clean_value(value)
        return cleaned
    
    def clean_list(self, lst):
        """Clean list for JSON serialization"""
        cleaned = []
        for item in lst:
            cleaned.append(self.clean_value(item))
        return cleaned
    
    def clean_dataframe(self, df):
        """Clean DataFrame for JSON serialization"""
        # Convert to list of lists format
        cleaned_data = []
        for _, row in df.iterrows():
            cleaned_row = []
            for col in df.columns:
                cleaned_row.append(self.clean_value(row[col]))
            cleaned_data.append(cleaned_row)
        return cleaned_data

def safe_json_dumps(obj, **kwargs):
    """Safely convert any object to JSON string"""
    try:
        return json.dumps(obj, cls=SafeJSONEncoder, **kwargs)
    except Exception as e:
        logger.error(f"JSON serialization error: {e}")
        # Fallback: return a simple error message
        return json.dumps({"error": "Data serialization failed", "message": str(e)})

def make_json_serializable(obj):
    """Convert any object to JSON-serializable format"""
    encoder = SafeJSONEncoder()
    
    if obj is None:
        return None
    
    # For DataFrames, convert to list of lists
    if isinstance(obj, pd.DataFrame):
        return encoder.clean_dataframe(obj)
    
    # For Series, convert to list
    elif isinstance(obj, pd.Series):
        return encoder.clean_list(obj.tolist())
    
    # For dicts
    elif isinstance(obj, dict):
        return encoder.clean_dict(obj)
    
    # For lists/tuples
    elif isinstance(obj, (list, tuple)):
        return encoder.clean_list(obj)
    
    # For single values
    else:
        return encoder.clean_value(obj)

def sanitize_dataframe_for_json(df):
    """Sanitize entire DataFrame for JSON serialization"""
    if df is None or df.empty:
        return {'columns': [], 'data': []}
    
    # Get columns
    columns = df.columns.tolist()
    
    # Convert data to list of lists with proper sanitization
    data = []
    for _, row in df.iterrows():
        row_data = []
        for col in columns:
            value = row[col]
            
            # Handle various problematic types
            if pd.isna(value):
                row_data.append(None)
            elif isinstance(value, (np.floating, float)):
                if math.isnan(value) or math.isinf(value):
                    row_data.append(None)
                else:
                    row_data.append(float(value))
            elif isinstance(value, (np.integer, int)):
                row_data.append(int(value))
            elif isinstance(value, (np.bool_, bool)):
                row_data.append(bool(value))
            elif isinstance(value, (pd.Timestamp, datetime)):
                row_data.append(value.isoformat())
            elif isinstance(value, bytes):
                row_data.append(value.decode('utf-8', errors='ignore'))
            else:
                row_data.append(str(value) if value is not None else None)
        
        data.append(row_data)
    
    return {'columns': columns, 'data': data}


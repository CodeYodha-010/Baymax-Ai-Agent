class EnhancedSmartQueryExecutor(SmartQueryExecutor):
    """Enhanced executor with new capabilities"""
    
    def __init__(self):
        # Don't call super().__init__() to avoid creating base analyzer
        self.analyzer = EnhancedLLMInspiredQueryAnalyzer()
    
    async def execute(self, query: str, df: pd.DataFrame, data_context: Dict[str, Any]) -> Dict[str, Any]:
        """Execute with enhanced understanding"""
        
        # Use enhanced analyzer with DataFrame
        context = self.analyzer.analyze(query, df)
        
        # Apply filters
        filtered_df = df.copy()
        
        # Apply compound filters if present
        if 'compound' in context.filters:
            filtered_df = self._apply_compound_filters(filtered_df, context.filters['compound'])
        elif context.filters:
            # Apply simple filters
            filtered_df = self._apply_filters(filtered_df, context.filters)
        
        # Apply domain filters
        if context.domain_context and 'filters' in context.domain_context:
            for col, values in context.domain_context['filters'].items():
                if col in filtered_df.columns:
                    filtered_df = filtered_df[filtered_df[col].isin(values)]
        
        # Log analysis results
        logger.info(f"Query Analysis Complete:")
        logger.info(f"  Intent: {context.selected_intent.name}")
        logger.info(f"  Confidence: {context.confidence:.2f}")
        logger.info(f"  IDs found: {context.get_ids}")
        logger.info(f"  Columns mentioned: {context.get_columns}")
        
        # Route to appropriate handler with filtered DataFrame
        if context.selected_intent == QueryType.SPECIFIC_LOOKUP:
            result = self._handle_lookup(context, filtered_df)
        elif context.selected_intent == QueryType.COUNT:
            result = self._handle_count(context, filtered_df)
        elif context.selected_intent == QueryType.STATISTICS:
            result = self._handle_statistics(context, filtered_df)
        elif context.selected_intent == QueryType.GROUP:
            result = self._handle_group(context, filtered_df)
        elif context.selected_intent == QueryType.FILTER:
            result = self._handle_filter(context, filtered_df)
        elif context.selected_intent == QueryType.COMPARE:
            result = self._handle_compare(context, filtered_df)
        elif context.selected_intent == QueryType.SORT:
            result = self._handle_sort(context, filtered_df)
        else:
            result = self._handle_search(context, filtered_df)
        
        # Update memory with results
        if hasattr(self.analyzer, 'memory_system'):
            if self.analyzer.memory_system.query_history:
                last_memory = self.analyzer.memory_system.query_history[-1]
                last_memory.results = result
                last_memory.successful = result.get('has_data', False)
        
        # Add enhanced metadata
        result['enhancements_applied'] = {
            'column_mapping': bool(context.entities),
            'value_inference': bool(context.filters),
            'compound_query': 'compound' in context.filters,
            'contextual_resolution': bool(context.context_hints),
            'domain_rules': bool(context.domain_context)
        }
        
        return result


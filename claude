class QueryType(Enum):
    """Query types with priority"""
    SPECIFIC_LOOKUP = (1, 0.95)  # (priority, base_confidence)
    COUNT = (2, 0.90)
    STATISTICS = (3, 0.85)
    GROUP = (4, 0.80)
    FILTER = (5, 0.75)
    COMPARE = (6, 0.80)
    SORT = (7, 0.70)
    SEARCH = (10, 0.50)  # Lowest priority
    
    @property
    def priority(self):
        return self.value[0]
    
    @property
    def base_confidence(self):
        return self.value[1]


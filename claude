                ],
                'keywords': ['where', 'filter', 'with', 'having', 'only'],
                'entity_requirement': None
            },
            QueryType.COMPARE: {
                'primary_patterns': [
                    r'compar[ei]',
                    r'(?:versus|vs\.?)',

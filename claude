        display_data = self._format_dataframe(sorted_df.head(MAX_DISPLAY_ROWS))
        
        return {
            'analysis': response,
            'has_data': True,
            'columns': display_data['columns'],
            'data': display_data['data'],
            'row_count': len(sorted_df),
            'query_type': 'sort',
            'confidence': context.confidence,

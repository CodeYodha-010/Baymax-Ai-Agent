            'sort_order': 'ascending' if ascending else 'descending'
        }
    
    def _handle_search(self, context: QueryContext, df: pd.DataFrame) -> Dict[str, Any]:
        """Handle general search queries"""
        
        filtered_df = self._apply_filters(df, context.filters)
        
        if context.tokens:
            search_terms = [t for t in context.tokens 
                          if len(t) > 2 and t not in ['show', 'find', 'get', 'all', 'data']]
            

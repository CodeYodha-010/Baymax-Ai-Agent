class NVIDIANIMService:
    """NVIDIA NIM AI Service with comprehensive error handling"""
    
    def __init__(self):
        self.api_key = NVIDIA_NIM_API_KEY
        self.model = NVIDIA_NIM_MODEL
        self.endpoint = NVIDIA_NIM_API_ENDPOINT
        self.enabled = bool(self.api_key)
        self.cache = DataAnalysisCache()
        
        if self.enabled:
            logger.info(f"✅ NVIDIA NIM Service initialized")
        else:
            logger.warning("❌ NVIDIA NIM Service disabled - no API key")
    
    async def analyze_data(self, query: str, df: pd.DataFrame, 
                          initial_result: Dict = None) -> Dict[str, Any]:
        """Analyze data with proper error handling"""
        
        if not self.enabled:
            return self._fallback_analysis(query, df, initial_result)
        
        # Clean the DataFrame first
        df = validate_and_clean_data(df)
        
        # Check cache
        data_hash = self._compute_data_hash(df)
        cached = self.cache.get(query, data_hash)
        if cached:
            return cached
        
        try:
            context = self._prepare_ai_context(df, query, initial_result)
            ai_response = await self._call_nvidia_nim(context)
            
            if ai_response:
                result = self._process_ai_response(ai_response, initial_result or {}, df)
                self.cache.set(query, data_hash, result)
                return result
                
        except Exception as e:
            logger.error(f"NVIDIA NIM error: {e}")
        
        return self._fallback_analysis(query, df, initial_result)
    
    def _prepare_ai_context(self, df: pd.DataFrame, query: str, 
                           initial_result: Dict = None) -> Dict:
        """Prepare context with proper sanitization"""
        
        # Get basic info
        context = {
            "user_query": query,
            "data_shape": df.shape,
            "columns": df.columns.tolist(),
            "data_types": {col: str(dtype) for col, dtype in df.dtypes.items()},
            "statistics": {}
        }
        
        # Add numeric statistics
        numeric_cols = df.select_dtypes(include=[np.number]).columns
        for col in numeric_cols[:3]:
            try:
                col_mean = df[col].mean()
                col_min = df[col].min()
                col_max = df[col].max()
                
                # Check for NaN/Inf and handle properly
                context["statistics"][col] = {
                    "mean": float(col_mean) if pd.notna(col_mean) and not np.isinf(col_mean) else None,
                    "min": float(col_min) if pd.notna(col_min) and not np.isinf(col_min) else None,
                    "max": float(col_max) if pd.notna(col_max) and not np.isinf(col_max) else None
                }
            except:
                context["statistics"][col] = {"error": "Could not compute statistics"}
        
        # Add categorical info
        categorical_cols = df.select_dtypes(include=['object']).columns
        for col in categorical_cols[:3]:
            try:
                context["statistics"][col] = {
                    "unique_values": int(df[col].nunique()),
                    "top_values": df[col].value_counts().head(3).to_dict()
                }
            except:
                context["statistics"][col] = {"error": "Could not analyze"}
        
        # Add sample data (sanitized)
        try:
            sample_df = df.head(3)
            context["sample_data"] = make_json_serializable(sample_df.to_dict('records'))
        except:
            context["sample_data"] = []
        
        return context
    
    async def _call_nvidia_nim(self, context: Dict) -> Optional[str]:
        """Call NVIDIA NIM with timeout and error handling"""
        
        try:
            # Ensure context is JSON serializable
            prompt = self._build_prompt(context)
            
            headers = {
                'Authorization': f'Bearer {self.api_key}',
                'Content-Type': 'application/json'
            }
            
            payload = {
                "model": self.model,
                "messages": [
                    {
                        "role": "system",
                        "content": "You are an expert data analyst. Provide clear insights."
                    },
                    {
                        "role": "user",
                        "content": prompt
                    }
                ],
                "temperature": NVIDIA_NIM_TEMPERATURE,
                "max_tokens": NVIDIA_NIM_MAX_TOKENS,
                "stream": False
            }
            
            timeout = aiohttp.ClientTimeout(total=30)
            
            async with aiohttp.ClientSession(timeout=timeout) as session:
                async with session.post(
                    self.endpoint,
                    headers=headers,
                    json=payload
                ) as response:
                    if response.status == 200:
                        result = await response.json()
                        return result.get('choices', [{}])[0].get('message', {}).get('content', '')
                    else:
                        logger.error(f"NVIDIA NIM API error: {response.status}")
                        return None
                        
        except asyncio.TimeoutError:
            logger.error("NVIDIA NIM API timeout")
            return None
        except Exception as e:
            logger.error(f"NVIDIA NIM API error: {e}")
            return None
    
    def _build_prompt(self, context: Dict) -> str:
        """Build prompt with sanitized data"""
        
        # Use safe JSON serialization
        stats_json = safe_json_dumps(context.get('statistics', {}), indent=2)
        sample_json = safe_json_dumps(context.get('sample_data', []), indent=2)
        
        prompt = f"""
Analyze this data to answer: "{context['user_query']}"

Dataset: {context['data_shape'][0]} rows × {context['data_shape'][1]} columns
Columns: {', '.join(context['columns'][:10])}

Statistics:
{stats_json}

Sample Data:
{sample_json}

Provide insights and answer the question.
"""
        return prompt
    
    def _process_ai_response(self, ai_response: str, initial_result: Dict, df: pd.DataFrame) -> Dict:
        """Process AI response safely"""
        
        result = initial_result.copy()
        result['ai_analysis'] = ai_response
        result['has_ai_insights'] = True
        result['analysis_type'] = 'nvidia_nim_enhanced'
        result['ai_model'] = self.model
        
        # Extract insights
        insights = []
        for line in ai_response.split('\n'):
            line = line.strip()
            if line.startswith(('•', '-', '*')):
                insights.append(line.lstrip('•-* ').strip())
        
        result['key_insights'] = insights[:5]
        
        return result
    
    def _fallback_analysis(self, query: str, df: pd.DataFrame, initial_result: Dict = None) -> Dict:
        """Fallback when AI is not available"""
        
        result = initial_result or {}
        result['ai_analysis'] = "AI analysis not available. Showing pattern-based results."
        result['has_ai_insights'] = False
        result['analysis_type'] = 'pattern_based'
        
        return result
    
    def _compute_data_hash(self, df: pd.DataFrame) -> str:
        """Compute hash safely"""
        try:
            hash_str = f"{df.shape}_{df.columns.tolist()}"
            return hashlib.md5(hash_str.encode()).hexdigest()[:16]
        except:
            return "default_hash"


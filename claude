class SmartQueryExecutor:
    """Execute queries based on analyzed context"""
    
    def __init__(self):
        self.analyzer = LLMInspiredQueryAnalyzer()
    
    async def execute(self, query: str, df: pd.DataFrame, data_context: Dict[str, Any]) -> Dict[str, Any]:
        """Execute query with smart analysis"""
        
        context = self.analyzer.analyze(query, df.columns.tolist())
        
        logger.info(f"Query Analysis Complete:")
        logger.info(f"  Intent: {context.selected_intent.name}")
        logger.info(f"  Confidence: {context.confidence:.2f}")
        logger.info(f"  IDs found: {context.get_ids}")
        logger.info(f"  Columns mentioned: {context.get_columns}")
        
        if context.selected_intent == QueryType.SPECIFIC_LOOKUP:
            return self._handle_lookup(context, df)
        elif context.selected_intent == QueryType.COUNT:
            return self._handle_count(context, df)
        elif context.selected_intent == QueryType.STATISTICS:
            return self._handle_statistics(context, df)
        elif context.selected_intent == QueryType.GROUP:
            return self._handle_group(context, df)
        elif context.selected_intent == QueryType.FILTER:
            return self._handle_filter(context, df)
        elif context.selected_intent == QueryType.COMPARE:
            return self._handle_compare(context, df)
        elif context.selected_intent == QueryType.SORT:
            return self._handle_sort(context, df)
        else:
            return self._handle_search(context, df)
    
    def _handle_lookup(self, context: QueryContext, df: pd.DataFrame) -> Dict[str, Any]:
        """Handle specific record lookup"""
        
        ids = context.get_ids
        if not ids:
            return self._error_response("No ID found in your query. Please specify an ID to look up.")
        
        logger.info(f"Looking up IDs: {ids}")
        
        found_records = pd.DataFrame()
        
        for specific_id in ids:
            mask = pd.Series([False] * len(df))
            
            for col in df.columns:
                try:
                    if df[col].dtype == 'object':
                        col_mask = df[col].astype(str).str.upper() == specific_id.upper()
                        mask |= col_mask
                        
                        if not col_mask.any():
                            col_mask = df[col].astype(str).str.contains(
                                specific_id, case=False, na=False, regex=False
                            )
                            mask |= col_mask
                except Exception as e:
                    logger.debug(f"Error searching column {col}: {e}")
            
            found = df[mask]
            if not found.empty:
                found_records = pd.concat([found_records, found])
        
        if not found_records.empty:
            found_records = found_records.drop_duplicates()
        
        if found_records.empty:
            response = f"❌ **No records found for ID(s): {', '.join(ids)}**\n\n"
            response += "**Possible reasons:**\n"
            response += "• The ID might be typed incorrectly\n"
            response += "• The record might not exist in this dataset\n"
            response += "• Try checking the ID format\n\n"
            
            similar = self._find_similar_ids(ids[0], df)
            if similar:
                response += "**Did you mean one of these?**\n"
                for sid in similar[:5]:
                    response += f"• {sid}\n"
            
            return {
                'analysis': response,
                'has_data': False,
                'columns': [],
                'data': [],
                'row_count': 0,
                'query_type': 'lookup',
                'confidence': context.confidence
            }
        
        if len(found_records) == 1:
            record = found_records.iloc[0]
            response = f"✅ **Found record for {ids[0]}**\n\n"
            
            desc_shown = False
            desc_cols = ['description', 'desc', 'details', 'summary', 'problem_description', 
                        'issue_description', 'content', 'explanation']
            
            for col in df.columns:
                if any(desc_term in col.lower() for desc_term in desc_cols):
                    value = record[col]
                    if pd.notna(value) and str(value).strip():
                        response += f"**{col}:**\n{value}\n\n"
                        desc_shown = True
                        break
            
            response += "**Complete Record Information:**\n"
            
            id_fields = []
            category_fields = []
            other_fields = []
            
            for col in df.columns:
                value = record[col]
                if pd.notna(value) and str(value).strip():
                    col_lower = col.lower()
                    if any(term in col_lower for term in ['id', 'code', 'number']):
                        id_fields.append((col, value))
                    elif any(term in col_lower for term in ['category', 'type', 'status', 'class']):
                        category_fields.append((col, value))
                    else:
                        other_fields.append((col, value))
            
            if id_fields:
                response += "\n🔑 **Identifiers:**\n"
                for col, val in id_fields:
                    response += f"• {col}: {val}\n"
            
            if category_fields:
                response += "\n📁 **Categories:**\n"
                for col, val in category_fields:
                    response += f"• {col}: {val}\n"
            
            if other_fields and not desc_shown:
                response += "\n📋 **Other Information:**\n"
                for col, val in other_fields[:5]:
                    response += f"• {col}: {val}\n"
        
        else:
            response = f"✅ **Found {len(found_records)} records matching your search**\n\n"
            
            if len(found_records) <= 5:
                for idx, (_, record) in enumerate(found_records.iterrows(), 1):
                    response += f"**Record {idx}:**\n"
                    
                    shown = 0
                    for col in df.columns:
                        if shown >= 5:
                            break
                        value = record[col]
                        if pd.notna(value) and str(value).strip():
                            response += f"• {col}: {value}\n"
                            shown += 1
                    response += "\n"
            else:
                response += f"Showing all {len(found_records)} records in the table below.\n"
        
        display_data = self._format_dataframe(found_records)
        
        return {
            'analysis': response,
            'has_data': True,
            'columns': display_data['columns'],
            'data': display_data['data'],
            'row_count': len(found_records),
            'query_type': 'lookup',
            'confidence': context.confidence,
            'ids_found': ids
        }
    
    def _handle_count(self, context: QueryContext, df: pd.DataFrame) -> Dict[str, Any]:
        """Handle count queries"""
        
        filtered_df = self._apply_filters(df, context.filters)
        
        count_target = None
        for token in context.tokens:
            if token in ['hardware', 'software', 'problem', 'issue', 'error']:
                count_target = token
                break
        
        if count_target:
            count_mask = pd.Series([False] * len(filtered_df))
            
            for col in filtered_df.select_dtypes(include=['object']).columns:
                try:
                    col_mask = filtered_df[col].astype(str).str.contains(
                        count_target, case=False, na=False
                    )
                    count_mask |= col_mask
                except:
                    pass
            
            count = count_mask.sum()
            total = len(filtered_df)
            
            response = f"📊 **Count Results**\n\n"
            response += f"Records containing '{count_target}': **{count:,}**\n"
            response += f"Out of {total:,} total records ({count/total*100:.1f}%)\n"
            
            if count > 0:
                subset_df = filtered_df[count_mask]
                cat_cols = subset_df.select_dtypes(include=['object']).columns
                
                for col in cat_cols:
                    if subset_df[col].nunique() <= 10:
                        response += f"\n**Breakdown by {col}:**\n"
                        value_counts = subset_df[col].value_counts().head(5)
                        for val, cnt in value_counts.items():
                            response += f"• {val}: {cnt} ({cnt/count*100:.1f}%)\n"
                        break
        
        else:
            count = len(filtered_df)
            total = len(df)
            
            response = f"📊 **Count Results**\n\n"
            response += f"Total records: **{count:,}**\n"
            
            if context.filters:
                response += f"(Filtered from {total:,} total records)\n"
        
        summary_data = pd.DataFrame({
            'Metric': ['Count', 'Percentage of Total'],
            'Value': [f"{count:,}", f"{count/len(df)*100:.1f}%"]
        })
        
        display_data = self._format_dataframe(summary_data)
        
        return {
            'analysis': response,
            'has_data': True,
            'columns': display_data['columns'],
            'data': display_data['data'],
            'row_count': len(summary_data),
            'query_type': 'count',
            'confidence': context.confidence,
            'count': count
        }
    
    def _handle_statistics(self, context: QueryContext, df: pd.DataFrame) -> Dict[str, Any]:
        """Handle statistical queries"""
        
        response = f"📈 **Statistical Analysis**\n\n"
        
        numeric_cols = df.select_dtypes(include=[np.number]).columns.tolist()
        
        target_cols = []
        for col in context.get_columns:
            if col in numeric_cols:
                target_cols.append(col)
        
        if not target_cols:
            target_cols = numeric_cols[:5]
        
        if not target_cols:
            response += "No numeric columns found for statistical analysis."
            return {
                'analysis': response,
                'has_data': False,
                'columns': [],
                'data': [],
                'row_count': 0,
                'query_type': 'statistics',
                'confidence': context.confidence
            }
        
        stats_data = []
        
        for col in target_cols:
            stats = {
                'Column': col,
                'Count': int(df[col].count()),
                'Mean': round(df[col].mean(), 2),
                'Median': round(df[col].median(), 2),
                'Std Dev': round(df[col].std(), 2),
                'Min': round(df[col].min(), 2),
                'Max': round(df[col].max(), 2)
            }
            stats_data.append(stats)
            
            response += f"**{col}:**\n"
            response += f"• Average: {stats['Mean']:,.2f}\n"
            response += f"• Median: {stats['Median']:,.2f}\n"
            response += f"• Range: {stats['Min']:,.2f} to {stats['Max']:,.2f}\n"
            response += f"• Standard Deviation: {stats['Std Dev']:,.2f}\n\n"
        
        response += "💡 **Insights:**\n"
        for stat in stats_data:
            if stat['Std Dev'] > stat['Mean'] * 0.5 and stat['Mean'] != 0:
                response += f"• {stat['Column']} shows high variability (CV = {stat['Std Dev']/stat['Mean']:.2f})\n"
            if stat['Max'] > stat['Mean'] * 3 and stat['Mean'] > 0:
                response += f"• {stat['Column']} may have outliers (max is {stat['Max']/stat['Mean']:.1f}x the mean)\n"
        
        stats_df = pd.DataFrame(stats_data)
        display_data = self._format_dataframe(stats_df)
        
        return {
            'analysis': response,
            'has_data': True,
            'columns': display_data['columns'],
            'data': display_data['data'],
            'row_count': len(stats_df),
            'query_type': 'statistics',
            'confidence': context.confidence
        }
    
    def _handle_group(self, context: QueryContext, df: pd.DataFrame) -> Dict[str, Any]:
        """Handle grouping queries"""
        
        group_col = None
        
        for col in context.get_columns:
            if col in df.columns:
                group_col = col
                break
        
        if not group_col:
            cat_cols = df.select_dtypes(include=['object']).columns
            for col in cat_cols:
                if 2 <= df[col].nunique() <= 20:
                    group_col = col
                    break
        
        if not group_col:
            return self._error_response("Could not find a suitable column for grouping. Please specify a column.")
        
        grouped = df.groupby(group_col).size().reset_index(name='Count')
        grouped = grouped.sort_values('Count', ascending=False)
        
        response = f"📊 **Data Grouped by {group_col}**\n\n"
        
        total = grouped['Count'].sum()
        
        for idx, row in grouped.iterrows():
            percentage = (row['Count'] / total * 100)
            response += f"• **{row[group_col]}**: {row['Count']:,} records ({percentage:.1f}%)\n"
            
            if idx >= 9:
                remaining = len(grouped) - 10
                if remaining > 0:
                    response += f"\n... and {remaining} more groups\n"
                break
        
        response += "\n💡 **Insights:**\n"
        top_group = grouped.iloc[0]
        response += f"• Most common {group_col}: {top_group[group_col]} ({top_group['Count']:,} records)\n"
        
        if len(grouped) > 1:
            concentration = grouped.head(3)['Count'].sum() / total * 100
            response += f"• Top 3 groups contain {concentration:.1f}% of all records\n"
        
        display_data = self._format_dataframe(grouped.head(20))
        
        return {
            'analysis': response,
            'has_data': True,
            'columns': display_data['columns'],
            'data': display_data['data'],
            'row_count': len(grouped),
            'query_type': 'group',
            'confidence': context.confidence,
            'group_column': group_col
        }
    
    def _handle_filter(self, context: QueryContext, df: pd.DataFrame) -> Dict[str, Any]:

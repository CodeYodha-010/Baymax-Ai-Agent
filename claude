@dataclass
class QueryCondition:
    """Represents a single query condition"""
    column: str
    operator: str
    value: Any
    confidence: float
    raw_text: str

@dataclass
class CompoundQuery:
    """Represents a decomposed compound query"""
    conditions: List[QueryCondition]
    logical_operators: List[str]
    raw_query: str
    
    def to_pandas_query(self) -> str:
        """Convert to pandas query string"""
        parts = []
        for i, cond in enumerate(self.conditions):
            if cond.operator == '=':
                parts.append(f"({cond.column} == {repr(cond.value)})")
            elif cond.operator == '!=':
                parts.append(f"({cond.column} != {repr(cond.value)})")
            elif cond.operator == '>':
                parts.append(f"({cond.column} > {cond.value})")
            elif cond.operator == '<':
                parts.append(f"({cond.column} < {cond.value})")
            elif cond.operator == 'contains':
                parts.append(f"({cond.column}.str.contains({repr(cond.value)}, case=False, na=False))")
            
            if i < len(self.logical_operators):
                parts.append(self.logical_operators[i].lower())
        
        return ' '.join(parts)

@dataclass
class QueryMemory:
    """Stores query context and results"""
    query: str
    timestamp: datetime
    intent: str
    entities: List[Entity]
    results: Dict[str, Any]
    successful: bool
    mappings: Dict[str, str]


                'entity_requirement': None
            },
            QueryType.SEARCH: {
                'primary_patterns': [
                    r'(?:show|find|search|list|get)\s+(?:me\s+)?(?:all)?',
                    r'(?:display|retrieve)\s+(?:all)?',
                ],
                'keywords': ['show', 'find', 'search', 'list', 'display'],
                'entity_requirement': None
            }
        }
        
        # Common misspellings and corrections
        self.corrections = {
            'discription': 'description',
            'decription': 'description',
            'infomation': 'information',
            'informaton': 'information',
            'explian': 'explain',
            'explane': 'explain',
            'detials': 'details',
            'deatils': 'details',
            'avrage': 'average',
            'avarage': 'average',
            'comparision': 'comparison',
            'catagory': 'category',
        }
        
        # Entity patterns
        self.entity_patterns = {
            'id': [
                r'\b([A-Z]{2,5}\d{3,6})\b',
                r'\bSIH\s*(\d+)\b',
                r'\b(?:id|ID|Id)[:\s]*([A-Za-z0-9]+)\b',
                r'#([A-Za-z0-9]+)',
                r'\b(\d{4,6})\b(?=\s+(?:problem|issue|record))',
            ],
            'column_indicators': ['by', 'of', 'for', 'column', 'field'],
            'value_indicators': ['is', 'equals', '=', 'contains', 'with'],
        }
    
    def analyze(self, query: str, df_columns: List[str]) -> QueryContext:
        """Analyze query using multi-stage pipeline"""
        
        logger.info(f"=== Analyzing query: '{query}' ===")
        
        normalized = self._preprocess(query)
        tokens = self._tokenize(normalized)
        entities = self._extract_entities(query, normalized, df_columns)
        intent_scores = self._score_intents(normalized, tokens, entities)
        selected_intent, confidence = self._select_intent(intent_scores, entities)
        filters = self._extract_filters(normalized, entities, df_columns)
        
        return QueryContext(
            original_query=query,
            normalized_query=normalized,
            tokens=tokens,
            entities=entities,
            intent_scores=intent_scores,
            selected_intent=selected_intent,
            confidence=confidence,
            filters=filters
        )
    
    def _preprocess(self, query: str) -> str:
        """Preprocess query with corrections"""
        processed = query.lower().strip()
        for wrong, correct in self.corrections.items():
            processed = processed.replace(wrong, correct)
        processed = ' '.join(processed.split())
        return processed
    
    def _tokenize(self, text: str) -> List[str]:
        """Tokenize text"""
        tokens = re.findall(r'\b\w+\b', text)
        return tokens
    
    def _extract_entities(self, original: str, normalized: str, df_columns: List[str]) -> List[Entity]:
        """Extract all entities from query"""
        entities = []
        
        # Extract IDs
        for pattern in self.entity_patterns['id']:
            for match in re.finditer(pattern, original, re.IGNORECASE):
                id_text = match.group(1) if match.lastindex else match.group(0)
                if 'sih' in normalized and id_text.isdigit():
                    id_text = f'SIH{id_text}'
                entities.append(Entity(
                    text=id_text,
                    entity_type='id',
                    confidence=1.0,
                    position=match.start()
                ))
        
        # Extract column mentions
        for col in df_columns:
            col_lower = col.lower()
            if re.search(r'\b' + re.escape(col_lower) + r'\b', normalized):
                entities.append(Entity(
                    text=col,
                    entity_type='column',
                    confidence=1.0,
                    position=normalized.find(col_lower)
                ))
            elif len(col) > 4 and col_lower in normalized:
                entities.append(Entity(
                    text=col,
                    entity_type='column',
                    confidence=0.8,
                    position=normalized.find(col_lower)
                ))
        
        # Extract values
        for match in re.finditer(r'["\']([^"\']+)["\']', normalized):
            entities.append(Entity(
                text=match.group(1),
                entity_type='value',
                confidence=0.9,
                position=match.start()
            ))
        
        # Remove duplicates
        seen = set()
        unique_entities = []
        for e in sorted(entities, key=lambda x: x.position):
            key = (e.text.lower(), e.entity_type)
            if key not in seen:
                seen.add(key)
                unique_entities.append(e)
        
        return unique_entities
    
    def _score_intents(self, normalized: str, tokens: List[str], entities: List[Entity]) -> Dict[QueryType, float]:
        """Score each intent type"""
        scores = {}
        
        for intent_type, config in self.intent_patterns.items():
            score = 0.0
            
            # Pattern matching
            pattern_score = 0.0
            for pattern in config['primary_patterns']:
                if re.search(pattern, normalized, re.IGNORECASE):
                    pattern_score = 1.0
                    break
            
            # Keyword matching
            keyword_score = 0.0
            matching_keywords = []
            for keyword in config['keywords']:
                if keyword in normalized:
                    matching_keywords.append(keyword)
            
            if matching_keywords:
                keyword_score = len(matching_keywords) / len(config['keywords'])
            
            # Entity requirement check
            entity_score = 1.0
            if config['entity_requirement']:
                if config['entity_requirement'] == 'id':
                    has_id = any(e.entity_type == 'id' for e in entities)
                    entity_score = 1.0 if has_id else 0.1
                elif config['entity_requirement'] == 'column':
                    has_column = any(e.entity_type == 'column' for e in entities)
                    entity_score = 1.0 if has_column else 0.5
            
            score = (pattern_score * 0.6 + keyword_score * 0.3 + entity_score * 0.1) * intent_type.base_confidence
            
            if intent_type == QueryType.SPECIFIC_LOOKUP and any(e.entity_type == 'id' for e in entities):
                score *= 1.5
            
            scores[intent_type] = score
        
        return scores
    
    def _select_intent(self, scores: Dict[QueryType, float], entities: List[Entity]) -> Tuple[QueryType, float]:
        """Select best intent with confidence"""
        
        has_id = any(e.entity_type == 'id' for e in entities)
        if has_id:
            lookup_words = ['description', 'describe', 'details', 'info', 'information', 'explain', 'about', 'what is']
            normalized = ' '.join([e.text.lower() for e in entities if e.entity_type != 'id'])
            
            for word in lookup_words:
                if word in normalized or word in scores:
                    return QueryType.SPECIFIC_LOOKUP, 0.95
        
        if not scores:
            return QueryType.SEARCH, 0.3
        
        sorted_intents = sorted(scores.items(), key=lambda x: (x[1], -x[0].priority), reverse=True)
        best_intent, best_score = sorted_intents[0]
        
        if len(sorted_intents) > 1:
            second_score = sorted_intents[1][1]
            if best_score - second_score < 0.2:
                confidence = best_score * 0.8
            else:
                confidence = best_score
        else:
            confidence = best_score
        
        return best_intent, min(confidence, 1.0)
    
    def _extract_filters(self, normalized: str, entities: List[Entity], df_columns: List[str]) -> Dict[str, Any]:
        """Extract filter conditions"""
        filters = {}
        
        filter_patterns = [
            (r'(\w+)\s*=\s*["\']?([^"\']+)["\']?', 'equals'),
            (r'(\w+)\s+is\s+["\']?([^"\']+)["\']?', 'equals'),
            (r'(\w+)\s+contains?\s+["\']?([^"\']+)["\']?', 'contains'),
            (r'(\w+)\s*>\s*(\d+)', 'greater'),
            (r'(\w+)\s*<\s*(\d+)', 'less'),
        ]
        
        for pattern, filter_type in filter_patterns:
            for match in re.finditer(pattern, normalized, re.IGNORECASE):
                col_name = match.group(1)
                value = match.group(2)
                
                matched_col = None
                for df_col in df_columns:
                    if col_name.lower() in df_col.lower():
                        matched_col = df_col
                        break
                
                if matched_col:
                    filters[matched_col] = {
                        'type': filter_type,
                        'value': value.strip()
                    }
        
        return filters


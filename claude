class QueryComplexityAnalyzer:
    """Analyze query complexity"""
    
    @staticmethod
    def needs_ai(query: str, initial_result: Dict = None) -> Tuple[bool, str]:
        query_lower = query.lower()
        
        for pattern in AI_REQUIRED_PATTERNS:
            if pattern in query_lower:
                return True, f"AI trigger: {pattern}"
        
        if all(word in query_lower for word in ['and', 'or', 'between']):
            return True, "Complex query"
        
        for pattern in SIMPLE_QUERY_PATTERNS:
            if pattern in query_lower and len(query.split()) < 10:
                return False, "Simple pattern query"
        
        return False, "Default to pattern matching"

